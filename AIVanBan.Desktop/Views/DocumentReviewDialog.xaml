<Window x:Class="AIVanBan.Desktop.Views.DocumentReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔍 AI Kiểm tra Văn bản" 
        Width="950" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 AI KIỂM TRA VĂN BẢN" 
                              FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtHeaderInfo" Text="Chính tả • Văn phong • Nội dung • Xung đột • Đề xuất" 
                              FontSize="12" Foreground="#B3D4FC" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- Score badge -->
                <Border x:Name="scoreBadge" Grid.Column="1" 
                       Background="#4CAF50" CornerRadius="30" 
                       Width="60" Height="60" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="txtScore" Text="0" 
                                  FontSize="24" FontWeight="Bold" Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="/10" FontSize="10" Foreground="#E8F5E9"
                                  HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- QUICK INPUT PANEL (chỉ hiện khi chế độ nhập nhanh) -->
        <Border x:Name="pnlQuickInput" Grid.Row="1" Background="White" 
               Padding="16,12" Visibility="Collapsed"
               BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📝 Dán hoặc nhập nội dung văn bản cần kiểm tra:" 
                              FontSize="13" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    <Button x:Name="btnUploadFile" 
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Height="28" Padding="10,0" Margin="12,0,0,0" FontSize="11"
                           Click="UploadFile_Click"
                           ToolTip="Tải file .docx, .pdf, .txt — nội dung sẽ được đổ vào ô bên dưới">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUpload" Width="14" Height="14" 
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="📎 Tải file lên" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- File info bar (hiện sau khi upload) -->
                <Border x:Name="pnlFileInfo" Grid.Row="1" Background="#E3F2FD" CornerRadius="4" 
                       Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" Foreground="#1565C0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtFileInfo" Text="" FontSize="12" Foreground="#1565C0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <TextBox x:Name="txtQuickInput" Grid.Row="2"
                        TextWrapping="Wrap" AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Height="160" FontSize="13"
                        materialDesign:HintAssist.Hint="Paste nội dung văn bản vào đây..."
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="txtCharCount" Grid.Column="0" 
                              Text="0 ký tự" FontSize="11" Foreground="#999"
                              VerticalAlignment="Center"/>
                    
                    <ComboBox x:Name="cboQuickDocType" Grid.Column="1" 
                             Width="160" Height="36" Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Loại văn bản (tùy chọn)"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="12"/>
                    
                    <Button x:Name="btnQuickCheck" Grid.Column="2"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="#1565C0" Foreground="White"
                           Height="36" Padding="20,0"
                           Click="QuickCheck_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TextSearch" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Kiểm tra" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 4: Tải file mẫu đối chiếu (tùy chọn) -->
                <Border Grid.Row="4" Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnUploadReference" 
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Height="28" Padding="10,0" FontSize="11"
                                   Click="UploadReference_Click"
                                   ToolTip="Tải file mẫu (.docx/.pdf/.txt) để AI so sánh, đối chiếu với VB cần kiểm tra">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileCompare" Width="14" Height="14" 
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="📎 Tải file mẫu đối chiếu (tùy chọn)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border x:Name="pnlReferenceInfo" Background="#FFF3E0" CornerRadius="4" 
                               Padding="10,6" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="FileCompare" Foreground="#E65100" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtReferenceInfo" Text="" FontSize="12" Foreground="#E65100" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="btnClearReference" Grid.Column="1"
                                       Style="{StaticResource MaterialDesignToolButton}"
                                       Height="20" Width="20" Padding="0"
                                       Click="ClearReference_Click" ToolTip="Xóa file mẫu">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#999"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">
            <!-- Loading state -->
            <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6" 
                           Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                <TextBlock x:Name="txtLoadingStatus" 
                          Text="⏳ Đang phân tích văn bản..." 
                          FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0"
                          Foreground="#666"/>
                <TextBlock x:Name="txtLoadingTimer" 
                          Text="" 
                          FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                          Foreground="#999"/>
            </StackPanel>

            <!-- Results -->
            <Grid x:Name="pnlResults" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Issues list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <materialDesign:Card Grid.Row="0" Margin="12,12,6,4" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="txtSummary" TextWrapping="Wrap" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="badgeCritical" Background="#FFEBEE" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtCriticalCount" Text="🔴 0 Nghiêm trọng" FontSize="12" Foreground="#D32F2F"/>
                                </Border>
                                <Border x:Name="badgeWarning" Background="#FFF8E1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtWarningCount" Text="🟡 0 Cần xem xét" FontSize="12" Foreground="#F57F17"/>
                                </Border>
                                <Border x:Name="badgeSuggestion" Background="#E8F5E9" CornerRadius="12" Padding="10,4">
                                    <TextBlock x:Name="txtSuggestionCount" Text="🟢 0 Gợi ý" FontSize="12" Foreground="#2E7D32"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Strengths -->
                    <materialDesign:Card x:Name="cardStrengths" Grid.Row="1" Margin="12,4,6,4" Padding="14"
                                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="💪 Điểm mạnh" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="lstStrengths">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" 
                                                  Foreground="#333" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Issues list -->
                    <ScrollViewer Grid.Row="2" Margin="12,4,6,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstIssues">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,8" Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Severity + Category + Location -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding SeverityIcon}" FontSize="14" Margin="0,0,6,0"/>
                                                <Border Background="{Binding CategoryBackground}" CornerRadius="8" Padding="8,2">
                                                    <TextBlock Text="{Binding CategoryDisplayText}" FontSize="11" Foreground="{Binding CategoryForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LocationDisplay}" FontSize="11" Foreground="#999" 
                                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>

                                            <!-- Row 1: Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" 
                                                      TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                                      Foreground="#333" Margin="0,0,0,6"/>

                                            <!-- Row 2: Original text -->
                                            <Border Grid.Row="2" Background="#FFF3E0" CornerRadius="6" 
                                                   Padding="10,6" Margin="0,0,0,6"
                                                   Visibility="{Binding HasOriginalText}">
                                                <StackPanel>
                                                    <TextBlock Text="Văn bản gốc:" FontSize="11" Foreground="#E65100" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" 
                                                              FontSize="12" Foreground="#BF360C" FontStyle="Italic" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Row 3: Suggestion -->
                                            <Border Grid.Row="3" Background="#E8F5E9" CornerRadius="6" 
                                                   Padding="10,6" Margin="0,0,0,6"
                                                   Visibility="{Binding HasSuggestion}">
                                                <StackPanel>
                                                    <TextBlock Text="💡 Đề xuất sửa:" FontSize="11" Foreground="#1B5E20" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" 
                                                              FontSize="12" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Row 4: Reason -->
                                            <TextBlock Grid.Row="4" Text="{Binding ReasonDisplay}" 
                                                      TextWrapping="Wrap" FontSize="11" Foreground="#888"
                                                      Visibility="{Binding HasReason}"/>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                            Background="#E0E0E0" ResizeDirection="Columns"/>

                <!-- RIGHT: Suggested content -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,12" Background="White" Margin="6,12,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📝 VĂN BẢN SAU KHI SỬA (có thể chỉnh sửa)" 
                                      FontWeight="Bold" FontSize="14" Foreground="#1565C0"
                                      VerticalAlignment="Center"/>
                            <Button x:Name="btnCopySuggested" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Height="30" Padding="12,0" FontSize="11"
                                   Click="CopySuggested_Click"
                                   ToolTip="Copy nội dung đã sửa">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" 
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Copy"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="6,4,12,12" Background="White" CornerRadius="4">
                        <TextBox x:Name="txtSuggestedContent" 
                                TextWrapping="Wrap" AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                IsReadOnly="False"
                                FontSize="13" Padding="14" BorderThickness="0"
                                FontFamily="Segoe UI"
                                materialDesign:HintAssist.Hint="Bạn có thể chỉnh sửa trực tiếp nội dung tại đây"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Error state -->
            <StackPanel x:Name="pnlError" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="Collapsed">
                <TextBlock Text="❌" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtError" Text="" TextWrapping="Wrap" MaxWidth="500"
                          FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"
                          Foreground="#D32F2F" TextAlignment="Center"/>
                <Button Content="🔄 Thử lại" Margin="0,16,0,0" 
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- FOOTER: Panel options rõ ràng -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" 
               BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Score text -->
                <TextBlock x:Name="txtScoreText" Grid.Row="0" 
                          FontSize="13" Foreground="#666" Margin="0,0,0,8"/>

                <!-- Options panel — hiện sau khi kiểm tra xong -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Action buttons panel -->
                    <StackPanel x:Name="pnlActions" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                        <!-- Option 1: Xuất Word -->
                        <Button x:Name="btnExportWord"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#2E7D32" Foreground="White"
                               Click="ExportWord_Click"
                               Margin="0,0,8,0"
                               Height="36"
                               ToolTip="Tải file Word (.docx) chuẩn NĐ 30/2020 về máy tính">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileWord" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="📄 Xuất Word" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Option 2: Áp dụng nội dung đã sửa -->
                        <Button x:Name="btnApply"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#1565C0" Foreground="White"
                               Click="Apply_Click"
                               Margin="0,0,8,0"
                               Height="36"
                               ToolTip="Áp dụng nội dung đã sửa và đóng cửa sổ">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="✅ Áp dụng" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Copy kết quả -->
                        <Button x:Name="btnCopyResult"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Click="CopyResult_Click"
                               Margin="0,0,8,0"
                               Height="36"
                               ToolTip="Copy toàn bộ kết quả kiểm tra vào clipboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Copy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Đóng -->
                    <Button Grid.Column="1" Content="Đóng"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Click="Close_Click"
                           Height="36"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
