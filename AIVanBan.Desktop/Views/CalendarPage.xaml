<Page x:Class="AIVanBan.Desktop.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Lịch tổng hợp"
      Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="500"/>
            <ColumnDefinition Width="5"/><!-- GridSplitter -->
            <ColumnDefinition Width="400" MinWidth="280" MaxWidth="600"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: LỊCH ═══ -->
        <DockPanel Grid.Column="0" Margin="20">
            
            <!-- HEADER: Điều hướng tháng -->
            <materialDesign:Card DockPanel.Dock="Top" Padding="20,14" Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel LastChildFill="True">

                    <!-- LEFT: Nav buttons + Today + Tháng/năm (cùng nhóm, không bị căn giữa cứng) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Click="PrevMonth_Click" ToolTip="Tháng trước">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Click="NextMonth_Click" ToolTip="Tháng sau">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="34" Click="Today_Click" Margin="6,0,12,0"
                                Content="📍 Hôm nay" FontSize="13" FontWeight="Medium"
                                Padding="10,0"/>
                        <TextBlock x:Name="txtMonthYear"
                                   Text="Tháng 01/2025" FontSize="20" FontWeight="Bold"
                                   Foreground="#1A237E"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MinWidth="140"/>
                    </StackPanel>

                    <!-- RIGHT: View toggle + Legend (wrap khi cửa sổ hẹp) -->
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                               Orientation="Horizontal" Margin="12,0,0,0">
                        <!-- View Toggle: Tháng / Tuần -->
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="2" Margin="0,2,12,2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnViewMonth" Content="📅 Tháng" 
                                        Click="ViewMonth_Click" FontSize="12" FontWeight="SemiBold"
                                        Padding="10,4" Margin="2" Height="30"
                                        Background="#1565C0" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="btnViewWeek" Content="📋 Tuần"
                                        Click="ViewWeek_Click" FontSize="12" FontWeight="SemiBold"
                                        Padding="10,4" Margin="2" Height="30"
                                        Background="Transparent" Foreground="#1565C0" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFCDD2" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                            <TextBlock Text="🔴 Quá hạn" FontSize="12" FontWeight="Medium" Foreground="#C62828"/>
                        </Border>
                        <Border Background="#FFF9C4" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                            <TextBlock Text="🟡 Sắp hạn" FontSize="12" FontWeight="Medium" Foreground="#F57F17"/>
                        </Border>
                        <Border Background="#BBDEFB" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                            <TextBlock Text="🔵 Họp" FontSize="12" FontWeight="Medium" Foreground="#1565C0"/>
                        </Border>
                        <Border Background="#C8E6C9" CornerRadius="6" Padding="8,4" Margin="0,2,0,2">
                            <TextBlock Text="🟢 Nhiệm vụ" FontSize="12" FontWeight="Medium" Foreground="#2E7D32"/>
                        </Border>
                    </WrapPanel>
                </DockPanel>
            </materialDesign:Card>
            
            <!-- CALENDAR GRID — MONTH VIEW -->
            <materialDesign:Card x:Name="cardMonthView" Padding="12" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Tiêu đề ngày trong tuần -->
                    <UniformGrid Grid.Row="0" Columns="7">
                        <TextBlock Text="Thứ 2" FontWeight="Bold" FontSize="14" Foreground="#37474F" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Thứ 3" FontWeight="Bold" FontSize="14" Foreground="#37474F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Thứ 4" FontWeight="Bold" FontSize="14" Foreground="#37474F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Thứ 5" FontWeight="Bold" FontSize="14" Foreground="#37474F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Thứ 6" FontWeight="Bold" FontSize="14" Foreground="#37474F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Thứ 7" FontWeight="Bold" FontSize="14" Foreground="#E65100"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="CN" FontWeight="Bold" FontSize="14" Foreground="#C62828"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </UniformGrid>
                    
                    <!-- Ô ngày -->
                    <UniformGrid x:Name="calendarGrid" Grid.Row="1" Columns="7" Rows="6"/>
                </Grid>
            </materialDesign:Card>

            <!-- CALENDAR GRID — WEEK VIEW -->
            <materialDesign:Card x:Name="cardWeekView" Padding="12" materialDesign:ElevationAssist.Elevation="Dp2"
                                 Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Tiêu đề ngày trong tuần (với ngày cụ thể) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/><!-- Cột giờ -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay0" Grid.Column="1" Text="T2 01/01" FontWeight="Bold" FontSize="13" Foreground="#37474F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay1" Grid.Column="2" Text="T3 02/01" FontWeight="Bold" FontSize="13" Foreground="#37474F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay2" Grid.Column="3" Text="T4 03/01" FontWeight="Bold" FontSize="13" Foreground="#37474F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay3" Grid.Column="4" Text="T5 04/01" FontWeight="Bold" FontSize="13" Foreground="#37474F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay4" Grid.Column="5" Text="T6 05/01" FontWeight="Bold" FontSize="13" Foreground="#37474F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay5" Grid.Column="6" Text="T7 06/01" FontWeight="Bold" FontSize="13" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWeekDay6" Grid.Column="7" Text="CN 07/01" FontWeight="Bold" FontSize="13" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Time-slot grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="weekTimeGrid"/>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </DockPanel>

        <!-- ═══ SPLITTER: Kéo để thay đổi kích thước ═══ -->
        <GridSplitter Grid.Column="1" Width="5" 
                     HorizontalAlignment="Stretch" 
                     Background="#E0E0E0"
                     Cursor="SizeWE"/>

        <!-- ═══ RIGHT: CHI TIẾT NGÀY ═══ -->
        <Border Grid.Column="2" Margin="0,20,20,20">
            <materialDesign:Card Padding="20" materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock x:Name="txtSelectedDate" Text="Đang tải..." 
                                   FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
                        <TextBlock x:Name="txtEventSummary" Text="" FontSize="14" 
                                   Foreground="#666" Margin="0,6,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="eventListPanel">
                            
                            <!-- Placeholder khi chưa chọn ngày -->
                            <StackPanel x:Name="emptyEventState" HorizontalAlignment="Center" Margin="0,50,0,0">
                                <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="64" Height="64"
                                                        HorizontalAlignment="Center" Foreground="#CCC"/>
                                <TextBlock Text="Chọn một ngày trên lịch&#x0a;để xem sự kiện"
                                          TextAlignment="Center" FontSize="15" Foreground="#999" Margin="0,12,0,0"
                                          LineHeight="24"/>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>
        </Border>
    </Grid>
</Page>
