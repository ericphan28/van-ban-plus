<Page x:Class="AIVanBan.Desktop.Views.TemplateManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Quản lý mẫu">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📝 QUẢN LÝ MẪU VĂN BẢN" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Toolbar -->
        <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" 
                         materialDesign:HintAssist.Hint="🔍 Tìm kiếm mẫu văn bản..." 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalAlignment="Center"
                         KeyUp="Search_KeyUp"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                    <ComboBox x:Name="cboFilterType" 
                             materialDesign:HintAssist.Hint="Lọc theo loại"
                             Width="150" Margin="0,0,10,0"
                             SelectionChanged="FilterChanged"/>
                    
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1565C0" Foreground="White"
                            Click="OpenStore_Click" Margin="0,0,10,0"
                            ToolTip="Tải mẫu văn bản mới từ kho online">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudDownload" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="📦 Kho mẫu online"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="AddTemplate_Click" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Thêm mẫu"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource SecondaryHueMidBrush}"
                            Click="SeedDefaultTemplates_Click" Margin="0,0,10,0"
                            ToolTip="Xóa tất cả và tạo lại mẫu mặc định (đủ 29 loại VB + bản sao + phụ lục theo NĐ 30/2020)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseSync" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Khởi tạo mẫu mặc định"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="Refresh_Click">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- DataGrid -->
        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="dgTemplates" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      ScrollViewer.CanContentScroll="True"
                      MouseDoubleClick="Template_DoubleClick">
                
                <!-- Nhóm theo Loại văn bản để dễ tìm -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="#E3F2FD" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1565C0" Margin="10,6,5,6"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0} mẫu)'}" 
                                               FontSize="12" Foreground="#64B5F6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên mẫu" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Loại VB" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="Phân loại" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Lần dùng" Binding="{Binding UsageCount}" Width="80"/>
                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                    
                    <DataGridTemplateColumn Header="Thao tác" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Xem chi tiết" Click="ViewTemplate_Click"
                                            Tag="{Binding Id}">
                                        <materialDesign:PackIcon Kind="Eye"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            ToolTip="Soạn văn bản từ mẫu này" Click="UseTemplate_Click"
                                            Tag="{Binding Id}" Height="30" Padding="8,0"
                                            Foreground="#2E7D32">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileEditOutline" Width="16" Height="16" 
                                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Soạn VB" FontSize="12" FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Sửa" Click="EditTemplate_Click"
                                            Tag="{Binding Id}">
                                        <materialDesign:PackIcon Kind="Pencil"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Xóa" Click="DeleteTemplate_Click"
                                            Tag="{Binding Id}">
                                        <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>
