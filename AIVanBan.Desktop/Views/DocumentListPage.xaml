<Page x:Class="AIVanBan.Desktop.Views.DocumentListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Quản lý văn bản"
      Focusable="True"
      KeyDown="Page_KeyDown">
    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="📄 QUẢN LÝ VĂN BẢN" 
                       FontSize="18" FontWeight="Bold" 
                       VerticalAlignment="Center"/>
            <TextBlock Text="  •  " Foreground="#CCC" VerticalAlignment="Center" Margin="10,0"/>
            <TextBlock FontSize="11" Foreground="#999" VerticalAlignment="Center">
                <Run Text="Shortcuts: "/>
                <Run Text="Ctrl+F" FontWeight="SemiBold"/>
                <Run Text=" tìm kiếm, "/>
                <Run Text="Enter" FontWeight="SemiBold"/>
                <Run Text=" mở, "/>
                <Run Text="Delete" FontWeight="SemiBold"/>
                <Run Text=" xóa, "/>
                <Run Text="Ctrl+N" FontWeight="SemiBold"/>
                <Run Text=" thêm mới, "/>
                <Run Text="F5" FontWeight="SemiBold"/>
                <Run Text=" làm mới"/>
            </TextBlock>
        </StackPanel>

        <!-- Toolbar -->
        <materialDesign:Card Grid.Row="1" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="txtSearch" Grid.Row="0"
                         materialDesign:HintAssist.Hint="🔍 Tìm kiếm theo số, tiêu đề, nội dung..." 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalAlignment="Center"
                         KeyUp="Search_KeyUp"
                         materialDesign:TextFieldAssist.HasClearButton="True"/>

                <!-- Row 1: Quick Filters + Actions -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Quick Date Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Lọc nhanh:" FontWeight="SemiBold" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666"/>
                        
                        <Button x:Name="btnFilterToday" 
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterToday_Click"
                               Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Hôm nay" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="btnFilterWeek"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterWeek_Click"
                               Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarWeek" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Tuần này" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="btnFilterMonth"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterMonth_Click"
                               Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Tháng này" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="btnClearFilters"
                               Style="{StaticResource MaterialDesignFlatButton}"
                               Height="32" Padding="12,0"
                               Click="ClearFilters_Click"
                               Margin="8,0,0,0"
                               Foreground="#D32F2F">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterRemove" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Xóa lọc" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Separator -->
                        <Border Width="1" Background="#E0E0E0" Margin="10,4" VerticalAlignment="Stretch"/>
                        
                        <!-- Lọc sổ theo dõi cá nhân -->
                        <Button x:Name="btnFilterStarred"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterStarred_Click"
                               Margin="0,0,6,0"
                               BorderBrush="#FFC107">
                            <TextBlock Text="⭐ Quan trọng" FontSize="12"/>
                        </Button>
                        
                        <Button x:Name="btnFilterUnprocessed"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterUnprocessed_Click"
                               Margin="0,0,6,0"
                               BorderBrush="#FB8C00">
                            <TextBlock Text="⬜ Chưa xử lý" FontSize="12"/>
                        </Button>
                        
                        <Button x:Name="btnFilterOverdue"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="FilterOverdue_Click"
                               Margin="0,0,0,0"
                               BorderBrush="#C62828">
                            <TextBlock Text="⚠ Quá hạn" FontSize="12"/>
                        </Button>
                        
                        <!-- Thùng rác toggle -->
                        <Button x:Name="btnTrashToggle"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="TrashToggle_Click"
                               Margin="8,0,0,0"
                               BorderBrush="#9E9E9E">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="txtTrashToggle" Text="Thùng rác" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Trash-mode buttons: chỉ hiện khi đang xem thùng rác -->
                        <Button x:Name="btnEmptyTrash"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="32" Padding="12,0"
                               Click="EmptyTrash_Click"
                               Margin="8,0,0,0"
                               BorderBrush="#C62828"
                               Foreground="#C62828"
                               Visibility="Collapsed"
                               ToolTip="Xóa vĩnh viễn tất cả VB trong thùng rác">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Dọn sạch" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="AddDocument_Click" Margin="0,0,10,0" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Thêm mới"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="ScanImport_Click" Margin="0,0,10,0" Height="32"
                                Background="#E65100" Foreground="White"
                                ToolTip="Nhập văn bản từ file PDF/ảnh scan bằng AI">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CameraDocument" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Nhập từ scan"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Menu phụ: gom các chức năng ít dùng -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                StaysOpen="False"
                                                ToolTip="Thêm thao tác">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24"/>
                            </materialDesign:PopupBox.ToggleContent>
                            <StackPanel Width="220">
                                <Button Click="Refresh_Click" HorizontalContentAlignment="Left" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Làm mới danh sách" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Separator/>
                                <Button Click="SetupOrganization_Click" HorizontalContentAlignment="Left" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderCog" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Thiết lập thư mục" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Separator/>
                                <Button Click="GenerateDemo_Click" HorizontalContentAlignment="Left" Padding="12,8"
                                        ToolTip="Tạo 20 văn bản mẫu (có hạn xử lý) để thử nghiệm">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabasePlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF9800"/>
                                        <TextBlock Text="Tạo dữ liệu demo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
                
                <!-- Row 2: Type, Year & Advanced Search -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="cboType" 
                             materialDesign:HintAssist.Hint="Loại văn bản"
                             Width="140" Margin="0,0,10,0"
                             SelectionChanged="FilterChanged"
                             FontSize="12"/>
                    
                    <ComboBox x:Name="cboYear" 
                             materialDesign:HintAssist.Hint="Năm"
                             Width="100" Margin="0,0,15,0"
                             SelectionChanged="FilterChanged"
                             FontSize="12"/>
                    
                    <!-- Advanced Search Toggle -->
                    <Button x:Name="btnAdvancedSearch"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Height="32" Padding="12,0"
                           Click="AdvancedSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="iconAdvancedSearch" 
                                                    Kind="ChevronDown" Width="16" Height="16" 
                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtAdvancedSearch" Text="Tìm kiếm nâng cao" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
        
        <!-- Advanced Search Panel -->
        <materialDesign:Card x:Name="advancedPanel" Grid.Row="1" 
                            Padding="15" Margin="0,0,0,15"
                            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header with close button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="🔍 TÌM KIẾM NÂNG CAO" 
                              FontWeight="Bold" FontSize="13"
                              VerticalAlignment="Center"/>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                           Width="28" Height="28"
                           HorizontalAlignment="Right"
                           Click="AdvancedSearch_Click"
                           ToolTip="Đóng">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
                
                <!-- Row 1 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="txtSearchNumber" Grid.Column="0"
                            materialDesign:HintAssist.Hint="Số văn bản (VD: 123/CV-UBND)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            KeyUp="AdvancedFilter_Changed"/>
                    
                    <TextBox x:Name="txtSearchSigner" Grid.Column="2"
                            materialDesign:HintAssist.Hint="Người ký"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            KeyUp="AdvancedFilter_Changed"/>
                    
                    <ComboBox x:Name="cboDirection" Grid.Column="4"
                             materialDesign:HintAssist.Hint="Hướng văn bản"
                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                             SelectionChanged="AdvancedFilter_Changed"/>
                </Grid>
                
                <!-- Row 2 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <DatePicker x:Name="dpFromDate" Grid.Column="0"
                               materialDesign:HintAssist.Hint="Từ ngày"
                               Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                               SelectedDateChanged="AdvancedFilter_Changed"/>
                    
                    <DatePicker x:Name="dpToDate" Grid.Column="2"
                               materialDesign:HintAssist.Hint="Đến ngày"
                               Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                               SelectedDateChanged="AdvancedFilter_Changed"/>
                    
                    <ComboBox x:Name="cboWorkflowStatus" Grid.Column="4"
                             materialDesign:HintAssist.Hint="Trạng thái xử lý"
                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                             SelectionChanged="AdvancedFilter_Changed"/>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Layout 3 CỘT: TreeView | DataGrid | Preview Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMN 1: Folder TreeView -->
            <materialDesign:Card Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TreeView Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Folder" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="THƯ MỤC" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnExpandAll" 
                                       Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Mở rộng tất cả"
                                       Click="ExpandAll_Click"
                                       Width="24" Height="24"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="16" Height="16"/>
                                </Button>
                                <Button x:Name="btnCollapseAll"
                                       Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Thu gọn tất cả"
                                       Click="CollapseAll_Click"
                                       Width="24" Height="24"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Thêm thư mục"
                                        Click="AddFolder_Click"
                                        Width="24" Height="24"
                                        Margin="2,0">
                                    <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TreeView -->
                    <TreeView x:Name="tvFolders" Grid.Row="1" 
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Padding="5">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Thêm thư mục con" Click="AddSubFolder_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FolderPlus"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Đổi tên" Click="RenameFolder_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="RenameBox"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Xóa thư mục" Click="DeleteFolder_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <materialDesign:PackIcon Kind="{Binding IconKind}" 
                                                            Width="18" Height="18"
                                                            Foreground="{Binding IconColor}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DocumentCount, StringFormat=' ({0})'}" 
                                              Foreground="#999" FontSize="10" 
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="5" 
                         HorizontalAlignment="Stretch" 
                         Background="#E0E0E0"
                         Cursor="SizeWE"/>

            <!-- COLUMN 2: DataGrid -->
            <materialDesign:Card Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Quick Stats Bar + Bulk Actions -->
                    <Border Grid.Row="0" Background="#E3F2FD" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Stats -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="txtTotalDocs" Text="Tổng: 0 văn bản" 
                                          VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text=" | " Margin="8,0" VerticalAlignment="Center" Foreground="#999"/>
                                <TextBlock x:Name="txtFilteredDocs" Text="Hiển thị: 0" 
                                          VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="txtSelectedDocs" Text="" 
                                          VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                          Foreground="#FF6B35" Margin="8,0,0,0"
                                          Visibility="Collapsed"/>
                                
                                <!-- ☑ Nút Chọn tất cả — luôn hiển thị, dễ phát hiện -->
                                <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="10,4"/>
                                <Button x:Name="btnSelectAll" Click="SelectAll_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="28" Padding="8,0"
                                       ToolTip="Chọn tất cả văn bản hiển thị (Ctrl+A)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                                Foreground="#1565C0"/>
                                        <TextBlock Text="Chọn tất cả" FontSize="12" Foreground="#1565C0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                            <!-- Bulk Actions Toolbar (hiện khi có item được chọn) -->
                            <StackPanel x:Name="bulkActionsPanel" Grid.Column="1" 
                                       Orientation="Horizontal" HorizontalAlignment="Right"
                                       Visibility="Collapsed">
                                <TextBlock Text="Thao tác hàng loạt:" FontWeight="SemiBold" 
                                          VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                
                                <Button x:Name="btnBulkMove" Click="BulkMove_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Di chuyển các văn bản đã chọn sang thư mục khác">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderMove" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Di chuyển" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnBulkExport" Click="BulkExport_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Xuất tất cả các văn bản đã chọn ra Word">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileWord" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                                Foreground="#2B579A"/>
                                        <TextBlock Text="Xuất Word" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnBulkExportExcel" Click="BulkExportExcel_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Xuất danh sách các văn bản đã chọn ra Excel (.xlsx)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                                Foreground="#217346"/>
                                        <TextBlock Text="Xuất Excel" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnBulkTag" Click="BulkTag_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Gán tag cho các văn bản đã chọn">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Gán Tag" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnBulkChangeType" Click="BulkChangeType_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Thay đổi loại văn bản">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileReplace" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Đổi loại" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnCopyDocument" Click="CopyDocument_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Sao văn bản (Sao y / Sao lục / Trích sao) — Điều 25, NĐ 30/2020">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                                Foreground="#1565C0"/>
                                        <TextBlock Text="Sao VB" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnBulkDelete" Click="BulkDelete_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0" Margin="0,0,4,0"
                                       ToolTip="Xóa các văn bản đã chọn"
                                       Foreground="#D32F2F">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Xóa" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                
                                <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="8,0"/>
                                
                                <Button x:Name="btnClearSelection" Click="ClearSelection_Click"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="32" Padding="8,0"
                                       ToolTip="Bỏ chọn tất cả">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Bỏ chọn" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Empty State (when no documents) -->
                    <StackPanel x:Name="emptyStatePanel" Grid.Row="1" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                Width="80" Height="80"
                                                Foreground="#CCCCCC"
                                                HorizontalAlignment="Center"/>
                        <TextBlock Text="Chưa có văn bản nào" 
                                  FontSize="18" FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  Margin="0,20,0,8"
                                  Foreground="#666"/>
                        <TextBlock Text="Hãy thêm văn bản đầu tiên của bạn" 
                                  FontSize="14"
                                  HorizontalAlignment="Center"
                                  Foreground="#999"
                                  Margin="0,0,0,30"/>
                        
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Click="AddDocument_Click"
                               Height="40" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm văn bản mới" 
                                          VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        
                        <TextBlock HorizontalAlignment="Center" 
                                  Margin="0,20,0,0" FontSize="12" Foreground="#AAA">
                            <Run Text="Hoặc nhấn"/>
                            <Run Text="Ctrl+N" FontWeight="Bold" Foreground="#666"/>
                            <Run Text="để thêm nhanh"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- DataGrid -->
                    <DataGrid x:Name="dgDocuments" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          AlternationCount="2"
                          SelectionChanged="DataGrid_SelectionChanged"
                          MouseDoubleClick="DocumentDoubleClick"
                          PreviewKeyDown="DataGrid_PreviewKeyDown"
                          Sorting="DataGrid_Sorting"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowHeight="52">
                    
                    <!-- DataGrid Styles -->
                    <DataGrid.Resources>
                        <!-- Row style với alternating colors và selection rõ ràng -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <!-- Alternating row color - dòng chẵn -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                                <!-- Alternating row color - dòng lẻ -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                                
                                <!-- Cảnh báo hạn xử lý — Điều 24, NĐ 30/2020 -->
                                <DataTrigger Binding="{Binding RowBackground}" Value="#FFEBEE">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RowBackground}" Value="#FFF3E0">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                </DataTrigger>
                                
                                <!-- Hover effect - priority cao hơn -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                
                                <!-- SELECTED - màu xanh đậm rõ ràng, priority CAO NHẤT -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2196F3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                
                                <!-- Selected + Hover - xanh đậm hơn nữa -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                        
                        <!-- Cell style - transparent background to inherit row color -->
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" 
                                               BorderThickness="0"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <!-- Đánh dấu sao — Sổ theo dõi cá nhân -->
                        <DataGridTemplateColumn Header="⭐" Width="36" MinWidth="36" SortMemberPath="IsStarred" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StarIcon}" 
                                              Foreground="{Binding StarColor}" 
                                              FontSize="18" 
                                              HorizontalAlignment="Center"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="StarToggle_Click"
                                              Tag="{Binding Id}"
                                              ToolTip="Đánh dấu sao"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Số VB" Binding="{Binding Number}" Width="100" MinWidth="80" SortMemberPath="Number" CanUserSort="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Number}"/>
                                    <!-- Selected row - white text -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTemplateColumn Header="Tiêu đề" Width="2*" MinWidth="200" SortMemberPath="Title" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CopyIndicator}" FontSize="10" 
                                                   Foreground="#1565C0" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCopy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Loại" Width="100" MinWidth="90" SortMemberPath="Type" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TypeColor}" 
                                           CornerRadius="3" 
                                           Padding="6,3"
                                           HorizontalAlignment="Center"
                                           ToolTip="{Binding TypeText}">
                                        <TextBlock Text="{Binding TypeText}" 
                                                  Foreground="White" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột Hướng VB (Đi/Đến/NB) -->
                        <DataGridTemplateColumn Header="Hướng" Width="55" MinWidth="50" SortMemberPath="Direction" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding DirectionColor}" 
                                           CornerRadius="3" 
                                           Padding="5,2"
                                           HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DirectionText}" 
                                                  Foreground="White" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Ngày BH" Binding="{Binding IssueDate, StringFormat='dd/MM/yyyy'}" Width="90" MinWidth="85" SortMemberPath="IssueDate" CanUserSort="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <!-- Selected row - white text -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- Cột Hạn xử lý — Điều 24, NĐ 30/2020 -->
                        <DataGridTemplateColumn Header="Hạn xử lý" Width="110" MinWidth="100" SortMemberPath="DueDate" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeadlineText}" 
                                              FontSize="11" FontWeight="SemiBold"
                                              Foreground="{Binding DeadlineColor}" 
                                              TextTrimming="CharacterEllipsis"
                                              VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <TextBlock>
                                                <Run Text="Hạn: "/>
                                                <Run Text="{Binding DueDate, StringFormat='dd/MM/yyyy', TargetNullValue='Chưa có hạn'}"/>
                                            </TextBlock>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Cột Trạng thái workflow — click để chuyển nhanh -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="110" MinWidth="95" SortMemberPath="WorkflowStatus" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" 
                                           CornerRadius="10" 
                                           Padding="8,3"
                                           HorizontalAlignment="Center"
                                           Cursor="Hand"
                                           ToolTip="{Binding StatusTooltip}"
                                           MouseLeftButtonDown="StatusBadge_Click"
                                           Tag="{Binding Id}">
                                        <TextBlock Text="{Binding StatusText}" 
                                                  Foreground="White" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Trạng thái xử lý cá nhân — Sổ theo dõi -->
                        <DataGridTemplateColumn Header="Cá nhân" Width="75" MinWidth="70" SortMemberPath="MyStatus" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MyStatusColor}" 
                                           CornerRadius="8" 
                                           Padding="6,2"
                                           HorizontalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="PersonalStatusBadge_Click"
                                           Tag="{Binding Id}"
                                           ToolTip="Click để đổi trạng thái xử lý cá nhân">
                                        <TextBlock Text="{Binding MyStatusText}" 
                                                  Foreground="White" 
                                                  FontSize="9.5"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="📎 File đính kèm" Width="120" MinWidth="110" SortMemberPath="AttachmentCount" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Show count if has attachments -->
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="ManageAttachments_Click"
                                                Tag="{Binding Id}"
                                                Height="32"
                                                Padding="8,0"
                                                ToolTip="Click để quản lý file đính kèm"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AttachmentText}" 
                                                      FontSize="12"
                                                      Foreground="#FF6B35"
                                                      FontWeight="SemiBold"/>
                                        </Button>
                                        
                                        <!-- Show upload button if no attachments -->
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Click="ManageAttachments_Click"
                                                Tag="{Binding Id}"
                                                Height="32"
                                                Padding="8,4"
                                                ToolTip="Click để thêm file đính kèm"
                                                Visibility="{Binding HasNoAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Thêm file" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Thao tác" Width="140" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Xem" Click="ViewDocument_Click"
                                                Tag="{Binding Id}"
                                                Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Sửa" Click="EditDocument_Click"
                                                Tag="{Binding Id}"
                                                Width="30" Height="30"
                                                Visibility="{Binding EditVisibility}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Xuất Word (.docx)" Click="ExportWord_Click"
                                                Tag="{Binding Id}"
                                                Width="30" Height="30"
                                                Visibility="{Binding EditVisibility}">
                                            <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18" Foreground="#2B579A"/>
                                        </Button>
                                        <Button x:Name="btnRowRestore"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Phục hồi" Click="RestoreDocument_Click"
                                                Tag="{Binding Id}"
                                                Width="30" Height="30"
                                                Visibility="{Binding RestoreVisibility}">
                                            <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" Foreground="#2E7D32"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Xóa" Click="DeleteDocument_Click"
                                                Tag="{Binding Id}"
                                                Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#D32F2F"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" Width="5" 
                         HorizontalAlignment="Stretch" 
                         Background="#E0E0E0"
                         Cursor="SizeWE"/>

            <!-- COLUMN 3: PREVIEW PANEL -->
            <materialDesign:Card Grid.Column="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="FileEye" 
                                                        Width="20" Height="20"
                                                        VerticalAlignment="Center" 
                                                        Margin="0,0,8,0"/>
                                <TextBlock Text="XEM NHANH" 
                                          FontWeight="Bold" 
                                          FontSize="14"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPreviewHint" 
                                      Text="Chọn văn bản để xem nội dung" 
                                      FontSize="11" 
                                      Foreground="#666"
                                      FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview Content -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12">
                        <StackPanel x:Name="pnlPreview">
                            <!-- Document Info Card -->
                            <Border x:Name="docInfoCard" 
                                   Background="White" 
                                   BorderBrush="#E0E0E0" 
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="txtPreviewNumber" 
                                              Text="Số: ..."
                                              FontWeight="Bold"
                                              FontSize="13"
                                              Foreground="#1976D2"
                                              Margin="0,0,0,6"/>
                                    
                                    <TextBlock x:Name="txtPreviewTitle" 
                                              Text="Tiêu đề văn bản"
                                              FontSize="15"
                                              FontWeight="SemiBold"
                                              TextWrapping="Wrap"
                                              Margin="0,0,0,10"/>
                                    
                                    <Separator Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPreviewType" Text="..." Margin="0,0,0,6"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày ban hành:" FontWeight="SemiBold" Margin="0,0,0,6"
                                                   ToolTip="Ngày ban hành văn bản"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPreviewDate" Text="..." Margin="0,0,0,6"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cơ quan:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtPreviewIssuer" Text="..." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Trạng thái:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtPreviewStatus" Text="..."/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sổ theo dõi cá nhân Card -->
                            <Border x:Name="personalTrackingCard"
                                   Background="#FFFDE7" 
                                   BorderBrush="#FFD54F" 
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="📋 SỔ THEO DÕI CÁ NHÂN" 
                                              FontWeight="Bold" 
                                              FontSize="12"
                                              Foreground="#F57F17"
                                              Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" 
                                                   FontWeight="SemiBold" Margin="0,0,8,6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPreviewMyStatus" 
                                                   Text="Chưa xử lý" FontWeight="Bold" Margin="0,0,0,6"
                                                   VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ưu tiên:" 
                                                   FontWeight="SemiBold" Margin="0,0,8,6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPreviewPriority" 
                                                   Text="..." Margin="0,0,0,6"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hạn cá nhân:" 
                                                   FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtPreviewPersonalDeadline" 
                                                   Text="—"/>
                                    </Grid>
                                    
                                    <!-- Ghi chú bút phê -->
                                    <TextBlock Text="📝 Ghi chú:" FontWeight="SemiBold" FontSize="11.5" 
                                              Margin="0,4,0,4"/>
                                    <ItemsControl x:Name="icPreviewNotes" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="3" Padding="8,4" 
                                                        Margin="0,0,0,4" BorderBrush="#E0E0E0" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                                                   FontSize="12"/>
                                                        <TextBlock FontSize="10" Foreground="#999" Margin="0,2,0,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} — {1:dd/MM/yyyy HH:mm}">
                                                                    <Binding Path="TypeDisplay"/>
                                                                    <Binding Path="CreatedDate"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <!-- Quick add note -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtQuickNote" 
                                                materialDesign:HintAssist.Hint="Thêm ghi chú..."
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                FontSize="12"
                                                Height="32"
                                                Padding="8,4"
                                                KeyDown="QuickNote_KeyDown"/>
                                        <Button Grid.Column="1" 
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               Width="32" Height="32" Margin="4,0,0,0"
                                               ToolTip="Thêm ghi chú (Enter)"
                                               Click="AddQuickNote_Click">
                                            <materialDesign:PackIcon Kind="Send" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Recipients Card (Nơi nhận) -->
                            <Border x:Name="recipientsCard"
                                   Background="White" 
                                   BorderBrush="#E0E0E0" 
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="📬 NƠI NHẬN" 
                                              FontWeight="Bold" 
                                              FontSize="12"
                                              Margin="0,0,0,10"/>
                                    
                                    <TextBlock x:Name="txtPreviewRecipients" 
                                              TextWrapping="Wrap"
                                              FontFamily="Times New Roman"
                                              FontSize="13"
                                              LineHeight="20"
                                              Foreground="#333"/>
                                </StackPanel>
                            </Border>

                            <!-- Căn cứ Card -->
                            <Border x:Name="basedOnCard"
                                   Background="White" 
                                   BorderBrush="#E0E0E0" 
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="⚖️ CĂN CỨ" 
                                              FontWeight="Bold" 
                                              FontSize="12"
                                              Foreground="#6A1B9A"
                                              Margin="0,0,0,10"/>
                                    
                                    <TextBlock x:Name="txtPreviewBasedOn" 
                                              TextWrapping="Wrap"
                                              FontFamily="Times New Roman"
                                              FontSize="13"
                                              FontStyle="Italic"
                                              LineHeight="20"
                                              Foreground="#555"/>
                                </StackPanel>
                            </Border>

                            <!-- Document Content Preview -->
                            <Border x:Name="docContentCard"
                                   Background="White" 
                                   BorderBrush="#E0E0E0" 
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="📄 NỘI DUNG" 
                                              FontWeight="Bold" 
                                              FontSize="12"
                                              Margin="0,0,0,10"/>
                                    
                                    <ScrollViewer MaxHeight="400" 
                                                 VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="txtPreviewContent" 
                                                  TextWrapping="Wrap"
                                                  FontFamily="Times New Roman"
                                                  FontSize="13"
                                                  LineHeight="22"
                                                  Foreground="#333"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Empty State -->
                            <StackPanel x:Name="emptyState" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="0,60,0,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                        Width="64" Height="64"
                                                        Foreground="#CCCCCC"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,16"/>
                                <TextBlock Text="Chưa chọn văn bản nào" 
                                          FontSize="14" 
                                          Foreground="#999"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Click vào văn bản để xem nội dung" 
                                          FontSize="12" 
                                          Foreground="#BBB"
                                          HorizontalAlignment="Center"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview Actions -->
                    <Border Grid.Row="2" 
                           x:Name="previewActions"
                           BorderBrush="#E0E0E0" 
                           BorderThickness="0,1,0,0"
                           Padding="10,8"
                           Visibility="Collapsed">
                        <StackPanel>
                            <!-- Row 1: 3 nút AI ngang nhau -->
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button x:Name="btnPreviewAdvisory"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="#00796B"
                                       Foreground="White"
                                       Height="34"
                                       Click="AdvisoryDocument_Click"
                                       Margin="0,0,4,0"
                                       ToolTip="AI phân tích VB đến → tóm tắt, đề xuất xử lý, deadline">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="LightbulbOn" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="AI Tham mưu" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnPreviewReview"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="#1565C0"
                                       Foreground="White"
                                       Height="34"
                                       Click="ReviewDocument_Click"
                                       Margin="2,0,2,0"
                                       ToolTip="AI kiểm tra chính tả, văn phong, xung đột nội dung">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TextSearch" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="AI Kiểm tra" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnPreviewSummary"
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="#6A1B9A"
                                       Foreground="White"
                                       Height="34"
                                       Click="SummaryDocument_Click"
                                       Margin="4,0,0,0"
                                       ToolTip="AI tóm tắt nội dung chính, trích xuất căn cứ pháp lý và số liệu">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TextBoxCheck" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="AI Tóm tắt" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            
                            <!-- Row 2: Sửa / Mở / Xóa — nhỏ gọn -->
                            <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                                <Button x:Name="btnPreviewEdit"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Click="EditDocument_Click"
                                       Height="32" Padding="4,0"
                                       Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Sửa" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnPreviewView"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Click="ViewDocument_Click"
                                       Height="32" Padding="4,0"
                                       Margin="2,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Mở" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="btnPreviewDelete"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Click="DeleteDocument_Click"
                                       Height="32" Padding="4,0"
                                       Margin="4,0,0,0"
                                       BorderBrush="#FFCDD2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" 
                                                                VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#D32F2F"/>
                                        <TextBlock Text="Xóa" FontSize="12" Foreground="#D32F2F" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
