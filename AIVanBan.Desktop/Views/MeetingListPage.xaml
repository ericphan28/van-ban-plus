<Page x:Class="AIVanBan.Desktop.Views.MeetingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Quản lý Cuộc họp">
    
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Search/Filter -->
            <RowDefinition Height="Auto"/>  <!-- Stats -->
            <RowDefinition Height="*"/>     <!-- Meeting List -->
        </Grid.RowDefinitions>
        
        <!-- ============ ROW 0: HEADER ============ -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12" 
                                  materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28" 
                                            VerticalAlignment="Center"/>
                    <TextBlock Text="QUẢN LÝ CUỘC HỌP" FontSize="18" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                           Padding="12,6" Margin="0,0,8,0"
                           Foreground="White" BorderBrush="#FFFFFF40"
                           Click="ExportAllMeetings_Click" ToolTip="Xuất danh sách cuộc họp ra Word">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileWord" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Xuất Word" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAddMeeting" Style="{StaticResource MaterialDesignRaisedButton}"
                           Padding="16,6" ToolTip="Thêm cuộc họp mới"
                           Click="AddMeetingDropdown_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm cuộc họp" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="6,0,0,0" Width="16" Height="16"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📋 Tạo đầy đủ" Click="AddMeeting_Click"
                                         ToolTip="Nhập đầy đủ thông tin cuộc họp (6 tab)"/>
                                <MenuItem Header="⚡ Tạo nhanh" Click="QuickAddMeeting_Click"
                                         ToolTip="Chỉ nhập tên, thời gian, địa điểm"/>
                                <Separator/>
                                <MenuItem Header="📄 Từ mẫu đã lưu" Click="CreateFromTemplate_Click"
                                         ToolTip="Tạo cuộc họp từ mẫu đã lưu"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>
        
        <!-- ============ ROW 1: SEARCH & FILTER ============ -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" 
                Padding="16,10" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <TextBox x:Name="txtSearch" Width="280" Margin="0,0,12,4"
                        materialDesign:HintAssist.Hint="🔍 Tìm kiếm cuộc họp..."
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        materialDesign:HintAssist.IsFloating="False"
                        KeyDown="TxtSearch_KeyDown"
                        TextChanged="TxtSearch_TextChanged"
                        Padding="8,6"/>
                
                <!-- Type Filter -->
                <ComboBox x:Name="cboType" Width="170" Margin="0,0,12,4"
                         materialDesign:HintAssist.Hint="Loại cuộc họp"
                         materialDesign:HintAssist.IsFloating="False"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tất cả loại" IsSelected="True" Tag=""/>
                </ComboBox>
                
                <!-- Status Filter -->
                <ComboBox x:Name="cboStatus" Width="150" Margin="0,0,12,4"
                         materialDesign:HintAssist.Hint="Trạng thái"
                         materialDesign:HintAssist.IsFloating="False"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tất cả" IsSelected="True" Tag=""/>
                    <ComboBoxItem Content="📅 Đã lên lịch" Tag="Scheduled"/>
                    <ComboBoxItem Content="🔴 Đang diễn ra" Tag="InProgress"/>
                    <ComboBoxItem Content="✅ Đã kết thúc" Tag="Completed"/>
                    <ComboBoxItem Content="⏸️ Hoãn" Tag="Postponed"/>
                    <ComboBoxItem Content="❌ Hủy" Tag="Cancelled"/>
                </ComboBox>
                
                <!-- Date From -->
                <DatePicker x:Name="dpFrom" Width="140" Margin="0,0,8,4"
                           materialDesign:HintAssist.Hint="Từ ngày"
                           materialDesign:HintAssist.IsFloating="False"
                           Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                           SelectedDateChanged="Filter_Changed"/>
                
                <!-- Date To -->
                <DatePicker x:Name="dpTo" Width="140" Margin="0,0,12,4"
                           materialDesign:HintAssist.Hint="Đến ngày"
                           materialDesign:HintAssist.IsFloating="False"
                           Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                           SelectedDateChanged="Filter_Changed"/>
                
                <!-- Clear Filter -->
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                       Padding="10,4" Margin="0,0,0,4"
                       Click="ClearFilter_Click" ToolTip="Xóa bộ lọc">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" Width="18" Height="18" 
                                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa lọc" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                
                <!-- ═══ Quick Filter Chips ═══ -->
                <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="12,4,8,4"/>
                <Button x:Name="btnFilterToday" Style="{StaticResource MaterialDesignFlatButton}" 
                       Padding="10,4" Height="32" Margin="0,0,4,4" FontSize="12"
                       Click="QuickFilter_Today" ToolTip="Chỉ hiện cuộc họp hôm nay"
                       Content="📍 Hôm nay"/>
                <Button x:Name="btnFilterWeek" Style="{StaticResource MaterialDesignFlatButton}" 
                       Padding="10,4" Height="32" Margin="0,0,4,4" FontSize="12"
                       Click="QuickFilter_Week" ToolTip="Cuộc họp tuần này"
                       Content="📅 Tuần này"/>
                <Button x:Name="btnFilterMonth" Style="{StaticResource MaterialDesignFlatButton}" 
                       Padding="10,4" Height="32" Margin="0,0,4,4" FontSize="12"
                       Click="QuickFilter_Month" ToolTip="Cuộc họp tháng này"
                       Content="📆 Tháng này"/>
                <Button x:Name="btnFilterUpcoming" Style="{StaticResource MaterialDesignFlatButton}" 
                       Padding="10,4" Height="32" Margin="0,0,0,4" FontSize="12"
                       Click="QuickFilter_Upcoming" ToolTip="Cuộc họp sắp tới (7 ngày)"
                       Content="⏰ Sắp tới"/>
            </WrapPanel>
        </Border>
        
        <!-- ============ ROW 2: STATS DASHBOARD ============ -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Padding="12,8" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
            <UniformGrid Columns="5" x:Name="statsDashboard">
                <!-- Card 1: Tổng -->
                <Border Background="White" CornerRadius="8" Margin="4" Padding="12,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#E3F2FD" CornerRadius="6" Width="36" Height="36" 
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#1976D2"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock Text="cuộc họp" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Card 2: Tháng này -->
                <Border Background="White" CornerRadius="8" Margin="4" Padding="12,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#E8F5E9" CornerRadius="6" Width="36" Height="36" 
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="CalendarMonth" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#2E7D32"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatMonth" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                            <TextBlock Text="tháng này" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Card 3: Sắp tới -->
                <Border Background="White" CornerRadius="8" Margin="4" Padding="12,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFF3E0" CornerRadius="6" Width="36" Height="36" 
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ClockAlertOutline" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#E65100"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatUpcoming" Text="0" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock Text="sắp tới" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Card 4: NV chưa xong -->
                <Border Background="White" CornerRadius="8" Margin="4" Padding="12,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#E8EAF6" CornerRadius="6" Width="36" Height="36" 
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#283593"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatPending" Text="0" FontSize="20" FontWeight="Bold" Foreground="#283593"/>
                            <TextBlock Text="Nhiệm vụ chưa xong" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Card 5: NV quá hạn -->
                <Border x:Name="cardOverdue" Background="White" CornerRadius="8" Margin="4" Padding="12,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="iconBgOverdue" Background="#FFEBEE" CornerRadius="6" Width="36" Height="36" 
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#E53935"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatOverdue" Text="0" FontSize="20" FontWeight="Bold" Foreground="#E53935"/>
                            <TextBlock x:Name="txtOverdueLabel" Text="quá hạn" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
        </Border>
        
        <!-- ============ ROW 3: MEETING LIST ============ -->
        <Grid Grid.Row="3">
            <!-- Meeting Cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="meetingListPanel" Margin="16">
                    <!-- Meeting cards will be added here in code-behind -->
                </StackPanel>
            </ScrollViewer>
            
            <!-- Empty State -->
            <StackPanel x:Name="emptyState" Visibility="Collapsed"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="CalendarBlank" Width="80" Height="80" 
                                        Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                <TextBlock Text="Chưa có cuộc họp nào" FontSize="18" FontWeight="SemiBold"
                          Foreground="#757575" TextAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Nhấn nút &quot;Thêm cuộc họp&quot; để bắt đầu quản lý lịch họp"
                          FontSize="14" Foreground="#9E9E9E" TextAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                           Padding="20,8" Click="AddMeeting_Click" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm cuộc họp đầu tiên" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                           Padding="20,8" Click="SeedDemoMeetings_Click"
                           Foreground="#9E9E9E" BorderBrush="#E0E0E0"
                           ToolTip="⚠️ Chỉ dùng để thử nghiệm — sẽ tạo dữ liệu mẫu">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseImport" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thử với dữ liệu mẫu" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
