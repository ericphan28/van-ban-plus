<Window x:Class="AIVanBan.Desktop.Views.MeetingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cuộc họp" Height="720" Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- TabControl -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>
        
        <!-- ============ HEADER ============ -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarEdit" Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtDialogTitle" Text="THÊM CUỘC HỌP MỚI" FontSize="16" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>
        
        <!-- ============ TAB CONTROL ============ -->
        <TabControl Grid.Row="1" Margin="8" x:Name="tabControl"
                   Style="{StaticResource MaterialDesignNavigationRailTabControl}">
            
            <!-- ====== TAB 1: THÔNG TIN CHUNG ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thông tin" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel MaxWidth="750">
                        <!-- Tên cuộc họp -->
                        <TextBox x:Name="txtTitle" 
                                materialDesign:HintAssist.Hint="Tên cuộc họp *"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="15" Margin="0,0,0,12"/>
                        
                        <!-- Row: Số GM + Loại + Cấp -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="txtMeetingNumber" Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Số giấy mời (VD: 15/GM-UBND)"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            
                            <ComboBox x:Name="cboMeetingType" Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Loại cuộc họp"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            
                            <ComboBox x:Name="cboLevel" Grid.Column="4"
                                     materialDesign:HintAssist.Hint="Cấp cuộc họp"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </Grid>
                        
                        <!-- Row: Trạng thái + Ưu tiên -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox x:Name="cboStatus" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Trạng thái"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            
                            <ComboBox x:Name="cboPriority" Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Mức độ ưu tiên"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="⬜ 1 - Thấp" Tag="1"/>
                                <ComboBoxItem Content="🟦 2 - Bình thường" Tag="2"/>
                                <ComboBoxItem Content="🟨 3 - Trung bình" Tag="3" IsSelected="True"/>
                                <ComboBoxItem Content="🟧 4 - Cao" Tag="4"/>
                                <ComboBoxItem Content="🟥 5 - Rất cao" Tag="5"/>
                            </ComboBox>
                        </Grid>
                        
                        <!-- Separator -->
                        <TextBlock Text="⏰ THỜI GIAN" FontWeight="Bold" FontSize="13" Margin="0,8,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        
                        <!-- Row: Ngày bắt đầu + Giờ bắt đầu + Ngày kết thúc + Giờ kết thúc -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            
                            <DatePicker x:Name="dpStartDate" Grid.Column="0"
                                       materialDesign:HintAssist.Hint="Ngày bắt đầu *"
                                       materialDesign:HintAssist.IsFloating="True"
                                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            
                            <materialDesign:TimePicker x:Name="tpStartTime" Grid.Column="2"
                                                      materialDesign:HintAssist.Hint="Giờ bắt đầu"
                                                      materialDesign:HintAssist.IsFloating="True"
                                                      Is24Hours="True"
                                                      Style="{StaticResource MaterialDesignOutlinedTimePicker}"/>
                            
                            <DatePicker x:Name="dpEndDate" Grid.Column="4"
                                       materialDesign:HintAssist.Hint="Ngày kết thúc"
                                       materialDesign:HintAssist.IsFloating="True"
                                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            
                            <materialDesign:TimePicker x:Name="tpEndTime" Grid.Column="6"
                                                      materialDesign:HintAssist.Hint="Giờ kết thúc"
                                                      materialDesign:HintAssist.IsFloating="True"
                                                      Is24Hours="True"
                                                      Style="{StaticResource MaterialDesignOutlinedTimePicker}"/>
                        </Grid>
                        
                        <CheckBox x:Name="chkAllDay" Content="Cuộc họp cả ngày (không cần giờ cụ thể)" 
                                 Margin="0,0,0,12"/>
                        
                        <!-- Separator -->
                        <TextBlock Text="📍 ĐỊA ĐIỂM" FontWeight="Bold" FontSize="13" Margin="0,8,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        
                        <!-- Row: Hình thức + Địa điểm -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox x:Name="cboFormat" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Hình thức họp"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectionChanged="CboFormat_Changed"/>
                            
                            <TextBox x:Name="txtLocation" Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Địa điểm (VD: Phòng họp số 1, UBND xã)"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </Grid>
                        
                        <!-- Online Link (hiện khi format != TrucTiep) -->
                        <TextBox x:Name="txtOnlineLink" Margin="0,0,0,12"
                                materialDesign:HintAssist.Hint="🔗 Link họp trực tuyến (Zoom, Teams, Google Meet...)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Visibility="Collapsed"/>
                        
                        <!-- Tags -->
                        <TextBox x:Name="txtTags" Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="Tags / Nhãn phân loại (phân cách bằng dấu phẩy)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- ====== TAB 2: THÀNH PHẦN THAM DỰ ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thành phần" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="750" Margin="20,16">
                        <!-- Cơ quan tổ chức -->
                        <TextBox x:Name="txtOrganizingUnit"
                                materialDesign:HintAssist.Hint="Cơ quan / Đơn vị tổ chức"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,12"/>
                        
                        <!-- Chủ trì -->
                        <TextBlock Text="👤 CHỦ TRÌ" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtChairPerson" Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Họ và tên chủ trì"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <TextBox x:Name="txtChairPersonTitle" Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Chức vụ"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </Grid>
                        
                        <!-- Thư ký -->
                        <TextBox x:Name="txtSecretary"
                                materialDesign:HintAssist.Hint="Thư ký cuộc họp"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,16"/>
                        
                        <!-- Danh sách tham dự -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="👥 DANH SÁCH THAM DỰ" FontWeight="Bold" FontSize="13"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      VerticalAlignment="Center"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Padding="10,4" Click="AddAttendee_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="16" Height="16" 
                                                            VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Thêm người" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        
                        <!-- Attendee List -->
                        <StackPanel x:Name="attendeeListPanel">
                            <!-- Attendee cards will be added here -->
                        </StackPanel>
                        
                        <TextBlock x:Name="txtNoAttendees" Text="Chưa có thành phần tham dự. Nhấn 'Thêm người' để bắt đầu."
                                  FontSize="12" Foreground="#9E9E9E" FontStyle="Italic" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- ====== TAB 3: NỘI DUNG & KẾT LUẬN ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="TextBoxEdit" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nội dung" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="750" Margin="20,16">
                        <!-- Chương trình họp -->
                        <TextBlock Text="📋 CHƯƠNG TRÌNH / NỘI DUNG DỰ KIẾN" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBox x:Name="txtAgenda" 
                                materialDesign:HintAssist.Hint="Nhập chương trình cuộc họp (mỗi nội dung một dòng)..."
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="100" MaxHeight="200"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,16"/>
                        
                        <!-- Nội dung cuộc họp -->
                        <TextBlock Text="📝 NỘI DUNG CUỘC HỌP" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBox x:Name="txtContent"
                                materialDesign:HintAssist.Hint="Ghi chép nội dung cuộc họp..."
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="120" MaxHeight="250"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,16"/>
                        
                        <!-- Kết luận -->
                        <TextBlock Text="📌 KẾT LUẬN CUỘC HỌP" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBox x:Name="txtConclusion"
                                materialDesign:HintAssist.Hint="Kết luận của cuộc họp..."
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="120" MaxHeight="250"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,16"/>
                        
                        <!-- Ghi chú cá nhân -->
                        <TextBlock Text="🔒 GHI CHÚ CÁ NHÂN (chỉ mình xem)" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                  Foreground="#FB8C00"/>
                        <TextBox x:Name="txtPersonalNotes"
                                materialDesign:HintAssist.Hint="Ghi chú cá nhân, nhận xét riêng..."
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="80" MaxHeight="200"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,8"
                                Background="#FFFDE7"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- ====== TAB 4: NHIỆM VỤ ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nhiệm vụ" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ NHIỆM VỤ ĐƯỢC GIAO TỪ CUỘC HỌP" FontWeight="Bold" FontSize="13"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTaskStats" Text="" FontSize="12" Margin="12,0,0,0"
                                      Foreground="#757575" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Padding="10,4" Click="AddTask_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlaylistAdd" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Thêm nhiệm vụ" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    
                    <!-- Task Stats Bar -->
                    <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="12,6" Margin="0,0,0,12"
                           x:Name="taskStatsBar" Visibility="Collapsed">
                        <WrapPanel>
                            <TextBlock x:Name="txtTaskTotal" Text="Tổng: 0" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtTaskCompleted" Text="✅ Hoàn thành: 0" FontSize="12" Foreground="#43A047" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtTaskInProgress" Text="🔄 Đang làm: 0" FontSize="12" Foreground="#1976D2" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtTaskOverdue" Text="🔴 Quá hạn: 0" FontSize="12" Foreground="#E53935" Margin="0,0,16,0"/>
                        </WrapPanel>
                    </Border>
                    
                    <!-- Task List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="taskListPanel" MaxWidth="750">
                            <!-- Task cards will be added here -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <!-- ====== TAB 5: TÀI LIỆU / VĂN BẢN CUỘC HỌP ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Văn bản" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header + Add button -->
                    <DockPanel Grid.Row="0" Margin="20,16,20,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="20" Height="20" 
                                                    VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="VĂN BẢN / TÀI LIỆU CUỘC HỌP" FontWeight="Bold" FontSize="14"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="txtDocStats" Text="" FontSize="12" Margin="12,0,0,0"
                                      Foreground="#757575" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Padding="10,4" Click="AddDocument_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePlus" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Thêm văn bản" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    
                    <!-- Requirement notice -->
                    <Border Grid.Row="1" Background="#FFF3E0" CornerRadius="6" Padding="12,8" Margin="20,0,20,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" 
                                                    Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242" VerticalAlignment="Center">
                                <Run FontWeight="Bold" Foreground="#E65100">Lưu ý:</Run>
                                <Run> Mỗi cuộc họp cần có ít nhất </Run>
                                <Run FontWeight="Bold">Giấy mời họp</Run>
                                <Run> và các văn bản/văn kiện liên quan. Nhấn "Thêm văn bản" để bổ sung.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Document List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,4,20,16">
                            <!-- Document cards grouped by type -->
                            <StackPanel x:Name="documentListPanel">
                                <!-- Will be populated in code-behind -->
                            </StackPanel>
                            
                            <TextBlock x:Name="txtNoDocuments" 
                                      Text="Chưa có văn bản nào. Nhấn 'Thêm văn bản' để bắt đầu."
                                      FontSize="12" Foreground="#9E9E9E" FontStyle="Italic" Margin="0,8,0,16"
                                      HorizontalAlignment="Center"/>
                            
                            <!-- File đính kèm bổ sung -->
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" 
                                   Margin="0,8,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="📎 FILE ĐÍNH KÈM BỔ SUNG (slide, ảnh, tài liệu rời...)" 
                                                  FontWeight="Bold" FontSize="13"
                                                  Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                  VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               Padding="10,4" Click="AddAttachment_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Paperclip" Width="16" Height="16" 
                                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Thêm file" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                    
                                    <StackPanel x:Name="attachmentListPanel"/>
                                    
                                    <TextBlock x:Name="txtNoAttachments" Text="Chưa có file đính kèm."
                                              FontSize="12" Foreground="#9E9E9E" FontStyle="Italic" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <!-- ====== TAB 6: ALBUM ẢNH LIÊN QUAN ====== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ImageMultiple" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Album ảnh" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header + Add button -->
                    <DockPanel Grid.Row="0" Margin="20,16,20,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ImageMultiple" Width="20" Height="20" 
                                                    VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="ALBUM ẢNH LIÊN QUAN" FontWeight="Bold" FontSize="14"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="txtAlbumStats" Text="" FontSize="12" Margin="12,0,0,0"
                                      Foreground="#757575" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Padding="10,4" Click="LinkAlbum_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkPlus" Width="16" Height="16" 
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Liên kết album" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    
                    <!-- Info notice -->
                    <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="6" Padding="12,8" Margin="20,0,20,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" 
                                                    Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242" VerticalAlignment="Center">
                                <Run>Liên kết album ảnh từ</Run>
                                <Run FontWeight="Bold"> Album Ảnh </Run>
                                <Run>để lưu trữ hình ảnh cuộc họp. Nhấn "Liên kết album" để chọn từ danh sách có sẵn.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Linked Album List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,4,20,16">
                            <StackPanel x:Name="linkedAlbumListPanel">
                                <!-- Populated dynamically in code-behind -->
                            </StackPanel>
                            
                            <TextBlock x:Name="txtNoLinkedAlbums" 
                                      Text="Chưa liên kết album ảnh nào. Nhấn 'Liên kết album' để chọn album."
                                      FontSize="12" Foreground="#9E9E9E" FontStyle="Italic" Margin="0,12,0,16"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- ============ BUTTONS ============ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="txtCreatedInfo" Text="" FontSize="11" 
                              Foreground="#9E9E9E" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                           Content="Hủy" Padding="24,6" Margin="0,0,12,0"
                           Click="Cancel_Click"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                           Padding="24,6" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Lưu cuộc họp" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
