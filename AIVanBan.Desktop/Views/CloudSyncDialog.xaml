<Window x:Class="AIVanBan.Desktop.Views.CloudSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="☁️ Đồng bộ đám mây" Height="680" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="☁️ Đồng bộ đám mây" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Đồng bộ dữ liệu giữa máy tính và đám mây VanBanPlus" 
                       FontSize="13" Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Toggle bật/tắt Cloud Sync -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <DockPanel>
                        <ToggleButton x:Name="tglSyncEnabled" DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      Checked="SyncToggle_Changed" Unchecked="SyncToggle_Changed"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="☁️ Bật đồng bộ đám mây" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtSyncHint" 
                                       Text="Tự động sao lưu và đồng bộ dữ liệu lên cloud" 
                                       FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Trạng thái kết nối -->
                <GroupBox x:Name="grpStatus" Header="📊 Trạng thái" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="SecondaryLight">
                    <StackPanel Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtStatus" Text="Chưa kết nối" 
                                       FontSize="12" Margin="8,4" Foreground="Gray"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gói dịch vụ:" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPlan" Text="—" 
                                       FontSize="12" Margin="8,4" Opacity="0.8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thiết bị:" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDeviceName" Text="—" 
                                       FontSize="12" Margin="8,4" Opacity="0.8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Số thiết bị:" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtDeviceCount" Text="—" 
                                       FontSize="12" Margin="8,4" Opacity="0.8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Đồng bộ lần cuối:" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtLastSync" Text="Chưa bao giờ" 
                                       FontSize="12" Margin="8,4" Opacity="0.8"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Dung lượng:" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtStorage" Text="—" 
                                       FontSize="12" Margin="8,4" Opacity="0.8"/>
                        </Grid>

                        <!-- Storage progress bar -->
                        <ProgressBar x:Name="prgStorage" Height="6" Margin="0,8,0,4"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock x:Name="txtStorageDetail" Text="" FontSize="10" Opacity="0.5" 
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </GroupBox>

                <!-- Cấu hình đồng bộ -->
                <GroupBox x:Name="grpSyncConfig" Header="⚙️ Cấu hình đồng bộ" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                    <StackPanel Margin="8">
                        <!-- Auto sync -->
                        <DockPanel Margin="0,4">
                            <ToggleButton x:Name="tglAutoSync" DockPanel.Dock="Right"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="Đồng bộ tự động" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Interval -->
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Chu kỳ (phút):" FontSize="12" VerticalAlignment="Center" Width="120"/>
                            <TextBox x:Name="txtInterval" Text="5"
                                     materialDesign:HintAssist.Hint="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>

                        <!-- Sync on startup -->
                        <CheckBox x:Name="chkSyncOnStartup" Content="Đồng bộ khi khởi động app" 
                                  Margin="0,6" FontSize="12"/>

                        <!-- Sync on exit -->
                        <CheckBox x:Name="chkSyncOnExit" Content="Đồng bộ trước khi thoát" 
                                  Margin="0,6" FontSize="12"/>

                        <Separator Margin="0,8"/>
                        <TextBlock Text="Loại dữ liệu đồng bộ" FontSize="12" FontWeight="SemiBold" 
                                   Margin="0,4,0,8"/>

                        <CheckBox x:Name="chkSyncDocuments" Content="📄 Văn bản" Margin="0,4" IsChecked="True"/>
                        <CheckBox x:Name="chkSyncMeetings" Content="📅 Cuộc họp" Margin="0,4" IsChecked="True"/>
                        <CheckBox x:Name="chkSyncTemplates" Content="📋 Mẫu văn bản" Margin="0,4" IsChecked="True"/>
                        <CheckBox x:Name="chkSyncFolders" Content="📁 Thư mục" Margin="0,4" IsChecked="True"/>
                        <CheckBox x:Name="chkSyncPhotos" Content="📷 Ảnh &amp; Album" Margin="0,4" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Xung đột -->
                <GroupBox Header="⚠️ Xử lý xung đột" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="SecondaryLight">
                    <StackPanel Margin="8">
                        <RadioButton x:Name="rbAutoResolve" Content="Tự động (ưu tiên bản mới nhất)" 
                                     IsChecked="True" Margin="0,4" FontSize="12"/>
                        <RadioButton x:Name="rbManualResolve" Content="Hỏi tôi mỗi khi có xung đột" 
                                     Margin="0,4" FontSize="12"/>
                    </StackPanel>
                </GroupBox>

                <!-- Hành động -->
                <GroupBox Header="🔧 Hành động" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="SecondaryLight">
                    <WrapPanel Margin="8" Orientation="Horizontal">
                        <Button x:Name="btnSyncNow" Content="🔄 Đồng bộ ngay" 
                                Click="SyncNow_Click" Margin="0,0,8,8"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button x:Name="btnBackupNow" Content="💾 Sao lưu ngay" 
                                Click="BackupNow_Click" Margin="0,0,8,8"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button x:Name="btnRestoreBackup" Content="📥 Khôi phục từ cloud" 
                                Click="RestoreBackup_Click" Margin="0,0,8,8"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </WrapPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Click="Cancel_Click" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button x:Name="btnSave" Content="💾 Lưu cài đặt" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
