<Window x:Class="AIVanBan.Desktop.Views.ScanImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="📸 Nhập văn bản từ PDF/Ảnh scan" 
        Height="800" Width="1100"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="📸 NHẬP VĂN BẢN TỪ PDF/ẢNH SCAN" 
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Hỗ trợ nhiều file — Ghép trang hoặc tách riêng từng văn bản" 
                               FontSize="12" Foreground="#B3FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="8,4" Background="#BBDEFB" Margin="0,0,8,0">
                        <TextBlock Text="Multi-File" FontSize="11" 
                                   FontWeight="SemiBold" Foreground="#0D47A1"/>
                    </Border>
                    <Border CornerRadius="12" Padding="8,4" Background="#BBDEFB">
                        <TextBlock Text="AI Vision" FontSize="11" 
                                   FontWeight="SemiBold" Foreground="#0D47A1"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ===== MAIN CONTENT - Two columns ===== -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- LEFT: File list + controls -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" 
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- File list header -->
                    <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁 DANH SÁCH FILE" FontSize="12" FontWeight="Bold" Foreground="#424242"/>
                            <TextBlock x:Name="txtFileCount" Grid.Column="1" FontSize="11" Foreground="#9E9E9E"
                                       VerticalAlignment="Center" Text="0 file"/>
                        </Grid>
                    </Border>
                    
                    <!-- Mode selector: Ghép trang / Tách riêng -->
                    <Border Grid.Row="1" Padding="12,8" Background="#FFFDE7">
                        <StackPanel>
                            <TextBlock Text="Chế độ xử lý:" FontSize="11" FontWeight="SemiBold" Foreground="#F57F17" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <RadioButton x:Name="rbMerge" GroupName="ScanMode" IsChecked="True"
                                             Checked="ScanMode_Changed">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="border" CornerRadius="4" Padding="8,6"
                                                                Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                                                                Cursor="Hand">
                                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" 
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="12" FontWeight="SemiBold" Foreground="#1565C0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                    📄 Ghép trang
                                </RadioButton>
                                
                                <RadioButton x:Name="rbSeparate" Grid.Column="2" GroupName="ScanMode"
                                             Checked="ScanMode_Changed">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="border" CornerRadius="4" Padding="8,6"
                                                                Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                                                Cursor="Hand">
                                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#2E7D32"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                    📑 Tách riêng
                                </RadioButton>
                            </Grid>
                            <TextBlock x:Name="txtModeDescription" FontSize="10" Foreground="#9E9E9E" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="Ghép tất cả ảnh thành 1 văn bản (VD: scan VB nhiều trang)"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- File list area -->
                    <Grid Grid.Row="2">
                        <!-- Empty state with drag-drop hint -->
                        <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="12">
                            <materialDesign:PackIcon Kind="FileImageOutline" Width="48" Height="48" 
                                                     Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chưa chọn file" FontSize="13" Foreground="#757575"
                                       HorizontalAlignment="Center" Margin="0,8,0,4" FontWeight="SemiBold"/>
                            <TextBlock Text="Kéo thả file vào đây hoặc bấm nút bên dưới" FontSize="11" 
                                       Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hỗ trợ: PDF, JPG, PNG, BMP, TIFF, WebP" FontSize="10" 
                                       Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <!-- File ListView with thumbnails -->
                        <ListBox x:Name="lstFiles" Visibility="Collapsed"
                                  Margin="4,4,4,4"
                                  SelectionChanged="FileList_SelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,1" CornerRadius="6"
                                            Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Order number -->
                                            <Border Width="24" Height="24" CornerRadius="12" 
                                                    Background="#1565C0" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Order}" Foreground="White" FontSize="11"
                                                           FontWeight="Bold" HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Thumbnail -->
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4"
                                                    Margin="0,0,8,0" Background="#F5F5F5" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    <!-- PDF icon overlay -->
                                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="28" Height="28"
                                                                             Foreground="#C62828" HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Visibility="{Binding PdfIconVisibility}"/>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- File info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Foreground="#212121"/>
                                                <TextBlock Text="{Binding FileSize}" FontSize="10" Foreground="#9E9E9E"/>
                                            </StackPanel>
                                            
                                            <!-- Remove button -->
                                            <Button Grid.Column="3" Click="RemoveFile_Click"
                                                    Tag="{Binding FilePath}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="28" Height="28" Padding="0"
                                                    ToolTip="Xóa file này">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF5350"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    
                    <!-- Move up/down buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,4,12,4"
                                HorizontalAlignment="Center"
                                x:Name="pnlMoveButtons" Visibility="Collapsed">
                        <Button x:Name="btnMoveUp" Click="MoveUp_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28" Width="90" Margin="0,0,6,0" Padding="4,0"
                                FontSize="11" ToolTip="Di chuyển file lên trên">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Lên" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMoveDown" Click="MoveDown_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28" Width="90" Margin="0,0,6,0" Padding="4,0"
                                FontSize="11" ToolTip="Di chuyển file xuống dưới">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Xuống" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnClearAll" Click="ClearAll_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28" Width="90" Padding="4,0"
                                FontSize="11" Foreground="#EF5350" BorderBrush="#EF5350"
                                ToolTip="Xóa tất cả file">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Xóa hết" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Add files + Analyze buttons -->
                    <StackPanel Grid.Row="4" Margin="12,4,12,12">
                        <Button x:Name="btnChooseFile" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="ChooseFile_Click" Height="36"
                                Background="#1565C0" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" 
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm file PDF / Ảnh scan" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="btnAnalyze" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="Analyze_Click" Height="40" Margin="0,8,0,0"
                                Background="#E65100" Foreground="White"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" Width="20" Height="20" 
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         x:Name="iconAnalyze"/>
                                <TextBlock x:Name="txtAnalyzeButton" Text="🤖 Phân tích bằng AI" 
                                           FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- RIGHT: Extracted data form -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8,8,0,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 THÔNG TIN TRÍCH XUẤT" FontSize="12" 
                                       FontWeight="Bold" Foreground="#424242"/>
                            <TextBlock x:Name="txtExtractionStatus" FontSize="11" 
                                       Foreground="#9E9E9E" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Margin="16,12,16,16">
                            
                            <!-- Loading overlay -->
                            <Border x:Name="loadingPanel" Visibility="Collapsed"
                                    Background="#F5F5F5" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <ProgressBar x:Name="pbAnalyze" IsIndeterminate="True" Width="200" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="txtLoadingStatus" Text="🤖 Đang phân tích bằng AI..."
                                               FontSize="13" HorizontalAlignment="Center"
                                               Foreground="#E65100" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtLoadingDetail" 
                                               Text="Quá trình có thể mất 10-30 giây tùy độ dài văn bản"
                                               FontSize="11" HorizontalAlignment="Center"
                                               Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Batch progress (for separate mode) -->
                            <Border x:Name="batchPanel" Visibility="Collapsed"
                                    Background="#E8F5E9" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="txtBatchStatus" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#2E7D32" Text="📑 Đang xử lý từng file..."/>
                                    <ProgressBar x:Name="pbBatch" Minimum="0" Maximum="100" Value="0"
                                                 Height="8" Margin="0,8,0,4"
                                                 Foreground="#4CAF50"/>
                                    <TextBlock x:Name="txtBatchDetail" FontSize="11" Foreground="#757575"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Form fields -->
                            <StackPanel x:Name="formPanel">
                                
                                <!-- Row: Số VB + Loại VB -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="txtSoVanBan" FontSize="13" FontWeight="SemiBold"
                                             materialDesign:HintAssist.Hint="Số văn bản (VD: 15/GM-UBND)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    
                                    <ComboBox x:Name="cboLoaiVanBan" Grid.Column="2" FontSize="12"
                                              materialDesign:HintAssist.Hint="Loại văn bản"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </Grid>
                                
                                <!-- Row: Ngày BH + Cơ quan -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <DatePicker x:Name="dpNgayBanHanh" FontSize="12"
                                                materialDesign:HintAssist.Hint="Ngày ban hành"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                    
                                    <TextBox x:Name="txtCoQuanBanHanh" Grid.Column="2" FontSize="13"
                                             materialDesign:HintAssist.Hint="Cơ quan ban hành"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                                
                                <!-- Trích yếu -->
                                <TextBox x:Name="txtTrichYeu" FontSize="13" Margin="0,0,0,10"
                                         materialDesign:HintAssist.Hint="Trích yếu"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap" MinHeight="50" MaxHeight="80"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                
                                <!-- Row: Người ký + Hướng VB + Lĩnh vực -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="txtNguoiKy" FontSize="12"
                                             materialDesign:HintAssist.Hint="Người ký"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    
                                    <ComboBox x:Name="cboHuongVanBan" Grid.Column="2" FontSize="12"
                                              materialDesign:HintAssist.Hint="Hướng VB"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    
                                    <TextBox x:Name="txtLinhVuc" Grid.Column="4" FontSize="12"
                                             materialDesign:HintAssist.Hint="Lĩnh vực"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                                
                                <!-- Row: Độ khẩn + Độ mật -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox x:Name="cboDoKhan" FontSize="12"
                                              materialDesign:HintAssist.Hint="Độ khẩn"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    
                                    <ComboBox x:Name="cboDoMat" Grid.Column="2" FontSize="12"
                                              materialDesign:HintAssist.Hint="Độ mật"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </Grid>
                                
                                <!-- Row: Chức danh ký + Thẩm quyền ký + Địa danh -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="txtChucDanhKy" FontSize="12"
                                             materialDesign:HintAssist.Hint="Chức danh ký (VD: CHỦ TỊCH)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    
                                    <TextBox x:Name="txtThamQuyenKy" Grid.Column="2" FontSize="12"
                                             materialDesign:HintAssist.Hint="Thẩm quyền (TM., KT.)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    
                                    <TextBox x:Name="txtDiaDanh" Grid.Column="4" FontSize="12"
                                             materialDesign:HintAssist.Hint="Địa danh (VD: Gia Kiểm)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                                
                                <!-- Căn cứ pháp lý -->
                                <TextBox x:Name="txtCanCu" FontSize="12" Margin="0,0,0,10"
                                         materialDesign:HintAssist.Hint="Căn cứ pháp lý (mỗi căn cứ 1 dòng)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap" MinHeight="50" MaxHeight="100"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                
                                <!-- Nơi nhận -->
                                <TextBox x:Name="txtNoiNhan" FontSize="12" Margin="0,0,0,10"
                                         materialDesign:HintAssist.Hint="Nơi nhận (mỗi nơi 1 dòng)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap" MinHeight="40" MaxHeight="80"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                
                                <!-- Nội dung -->
                                <TextBox x:Name="txtNoiDung" FontSize="12" Margin="0,0,0,4"
                                         materialDesign:HintAssist.Hint="Nội dung văn bản (đầy đủ)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap" MinHeight="120" MaxHeight="300"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Times New Roman"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ===== FOOTER ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="txtFooterInfo" FontSize="11" Foreground="#9E9E9E" 
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnCancel"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="Cancel_Click" Height="34" Margin="0,0,10,0">
                        <TextBlock Text="Hủy" FontSize="13"/>
                    </Button>
                    
                    <Button x:Name="btnSave"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="Save_Click" Height="36"
                            Background="#2E7D32" Foreground="White"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" 
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSaveButton" Text="Lưu văn bản vào hệ thống" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
