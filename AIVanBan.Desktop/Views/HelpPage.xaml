<Page x:Class="AIVanBan.Desktop.Views.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Trợ giúp"
      Background="{DynamicResource MaterialDesignPaper}">

    <Page.Resources>
        <!-- Style cho mục lục chính -->
        <Style x:Key="TocButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <!-- Style cho mục lục con -->
        <Style x:Key="TocSubButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="28,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,30,0,12"/>
        </Style>

        <!-- Sub-section header -->
        <Style x:Key="SubSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <!-- Body text -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Step card -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Tip card (theme-aware) -->
        <SolidColorBrush x:Key="TipCardBackground" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="TipCardBorder" Color="#FFE082"/>
        <SolidColorBrush x:Key="WarningCardBackground" Color="#FFF3E0"/>
        <SolidColorBrush x:Key="WarningCardBorder" Color="#FFCC80"/>
        <SolidColorBrush x:Key="ChangelogNewBackground" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="ChangelogNewBorder" Color="#A5D6A7"/>

        <Style x:Key="TipCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TipCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TipCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Warning card (theme-aware) -->
        <Style x:Key="WarningCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarningCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Changelog new item -->
        <Style x:Key="ChangelogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChangelogNewBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChangelogNewBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: MỤC LỤC ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,16,16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="28" Height="28"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="HƯỚNG DẪN SỬ DỤNG" FontSize="16" FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                    <TextBlock Text="VanBanPlus — AI Văn Bản Hành Chính" FontSize="11" 
                              Opacity="0.6" Margin="38,2,0,0"/>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Row="1" Margin="12,4,12,8" CornerRadius="8" 
                        Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="8,0,4,0"
                                                VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox x:Name="txtSearch" Grid.Column="1" 
                                materialDesign:HintAssist.Hint="Tìm kiếm trợ giúp..."
                                BorderThickness="0" Background="Transparent"
                                VerticalAlignment="Center" FontSize="13"
                                TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnClearSearch" Grid.Column="2" 
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Visibility="Collapsed"
                                Click="ClearSearch_Click">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search result -->
                <TextBlock x:Name="txtSearchResult" Grid.Row="1" Margin="16,0,16,4" 
                          FontSize="11" Visibility="Collapsed"/>

                <!-- TOC Tree -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="tocPanel" Margin="0,0,0,16">
                        
                        <!-- 1. Bắt đầu nhanh -->
                        <TextBlock Text="BẮT ĐẦU" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource PrimaryHueMidBrush}" Opacity="0.7"
                                  Margin="16,8,0,4"/>
                        <Button Style="{StaticResource TocButton}" Tag="secOverview" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Giới thiệu phần mềm"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secFirstSetup" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RocketLaunch" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Thiết lập lần đầu"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secInterface" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MonitorScreenshot" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Giao diện tổng quan"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- 2. Văn bản -->
                        <TextBlock Text="VĂN BẢN" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource PrimaryHueMidBrush}" Opacity="0.7"
                                  Margin="16,12,0,4"/>
                        <Button Style="{StaticResource TocButton}" Tag="secDocManage" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản lý văn bản"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocSubButton}" Tag="secDocAdd" Click="TocItem_Click">
                            <TextBlock Text="• Thêm văn bản mới"/>
                        </Button>
                        <Button Style="{StaticResource TocSubButton}" Tag="secDocFolder" Click="TocItem_Click">
                            <TextBlock Text="• Thư mục &amp; phân loại"/>
                        </Button>
                        <Button Style="{StaticResource TocSubButton}" Tag="secDocSearch" Click="TocItem_Click">
                            <TextBlock Text="• Tìm kiếm &amp; lọc"/>
                        </Button>
                        <Button Style="{StaticResource TocSubButton}" Tag="secDocAttach" Click="TocItem_Click">
                            <TextBlock Text="• Đính kèm file"/>
                        </Button>
                        <Button Style="{StaticResource TocSubButton}" Tag="secDocExport" Click="TocItem_Click">
                            <TextBlock Text="• Xuất Word / Excel"/>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secRegister" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sổ văn bản"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secTemplate" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentEdit" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Mẫu văn bản"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secLegalRef" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#4CAF50"/>
                                <TextBlock Text="Tra cứu pháp quy"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secStatistics" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="Thống kê"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. AI -->
                        <TextBlock Text="✨ AI NÂNG CAO" FontSize="10" FontWeight="Bold" 
                                  Foreground="#FF9800" Opacity="0.85"
                                  Margin="16,12,0,4"/>
                        <Button Style="{StaticResource TocButton}" Tag="secAISetup" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudCheck" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="Kết nối &amp; đăng nhập AI"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAICompose" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Creation" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Soạn văn bản"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAIReport" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Báo cáo định kỳ"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAIScan" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Scanner" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Scan OCR"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAIReview" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextSearch" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Kiểm tra văn bản"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAIAdvisory" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LightbulbOn" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Tham mưu"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secAISummary" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxCheck" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#FF9800"/>
                                <TextBlock Text="AI Tóm tắt"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Công việc -->
                        <TextBlock Text="CÔNG VIỆC" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource PrimaryHueMidBrush}" Opacity="0.7"
                                  Margin="16,12,0,4"/>
                        <Button Style="{StaticResource TocButton}" Tag="secAlbum" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageMultiple" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Album ảnh"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secVietGovCMS" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudDownload" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#1565C0"/>
                                <TextBlock Text="Tải Album từ VietGov CMS"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secMeeting" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cuộc họp"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secCalendar" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#1565C0"/>
                                <TextBlock Text="Lịch tổng hợp" Foreground="#1565C0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Hệ thống -->
                        <TextBlock Text="HỆ THỐNG" FontSize="10" FontWeight="Bold" 
                                  Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6"
                                  Margin="16,12,0,4"/>
                        <Button Style="{StaticResource TocButton}" Tag="secWhatsNew" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="NewBox" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Foreground="#4CAF50"/>
                                <TextBlock Text="Có gì mới?" Foreground="#4CAF50" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secBackup" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseExport" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sao lưu &amp; Khôi phục"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secPlans" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCard" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Gói dịch vụ &amp; Thanh toán"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secFAQ" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FrequentlyAskedQuestions" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Câu hỏi thường gặp"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secContact" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Phone" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Liên hệ hỗ trợ"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TocButton}" Tag="secShortcuts" Click="TocItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyboardOutline" Width="18" Height="18" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Phím tắt"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ RIGHT: NỘI DUNG HELP ═══ -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="helpScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="helpContent" MaxWidth="900" Margin="32,16,32,40">

                <!-- ════════════════════════════════════════════════ -->
                <!-- SECTION: GIỚI THIỆU PHẦN MỀM -->
                <!-- ════════════════════════════════════════════════ -->
                <StackPanel x:Name="secOverview">
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="📋"/>
                        <Run Text=" Giới thiệu VanBanPlus"/>
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyText}">
                        <Bold>VanBanPlus</Bold> là phần mềm quản lý văn bản hành chính thông minh, 
                        tích hợp trí tuệ nhân tạo (AI), được phát triển bởi <Bold>Công ty TNHH Gia Kiệm Số</Bold>.
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,12">
                        Phần mềm giúp cán bộ, công chức tại các cơ quan hành chính (UBND xã/phường, 
                        cơ quan tỉnh/thành phố, đoàn thể, trường học, bệnh viện...) xử lý công việc văn bản 
                        nhanh hơn từ <Bold>4-6 giờ/ngày xuống chỉ còn 1-2 giờ/ngày</Bold>.
                    </TextBlock>

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <materialDesign:Card Margin="0,0,8,0" Padding="14" materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="32" Height="32"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Quản lý văn bản" FontWeight="SemiBold" FontSize="13" 
                                          HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                <TextBlock Text="Lưu trữ, phân loại, tìm kiếm&#x0a;29 loại văn bản theo NĐ 30/2020" 
                                          FontSize="11" TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="0,0,8,0" Padding="14" materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Creation" Width="32" Height="32"
                                                        HorizontalAlignment="Center" Foreground="#FF9800"/>
                                <TextBlock Text="7 tính năng AI" FontWeight="SemiBold" FontSize="13" 
                                          HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                <TextBlock Text="Soạn thảo, Scan OCR, Kiểm tra,&#x0a;Tham mưu, Tóm tắt, Báo cáo" 
                                          FontSize="11" TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="14" materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="32" Height="32"
                                                        HorizontalAlignment="Center" Foreground="#4CAF50"/>
                                <TextBlock Text="Dữ liệu an toàn" FontWeight="SemiBold" FontSize="13" 
                                          HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                <TextBlock Text="Lưu trữ cục bộ trên máy tính,&#x0a;tự động sao lưu hàng ngày" 
                                          FontSize="11" TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <Border Style="{StaticResource TipCard}">
                        <TextBlock Style="{StaticResource BodyText}" Margin="0">
                            <Run Text="💡 Lưu ý:" FontWeight="SemiBold"/>
                            <Run Text=" Tất cả dữ liệu văn bản được lưu trên máy tính của bạn (không upload lên mạng). 
Internet chỉ cần khi sử dụng các tính năng AI."/>
                        </TextBlock>
                    </Border>
                </StackPanel>


                <!-- ════════════════════════════════════════════════ -->
                <!-- SECTION: THIẾT LẬP LẦN ĐẦU -->
                <!-- ════════════════════════════════════════════════ -->
                <StackPanel x:Name="secFirstSetup">
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="🚀"/>
                        <Run Text=" Thiết lập lần đầu"/>
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyText}">
                        Khi mở phần mềm lần đầu tiên, hệ thống sẽ hướng dẫn bạn qua 3 bước thiết lập:
                    </TextBlock>

                    <!-- Bước 1 -->
                    <Border Style="{StaticResource StepCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="12" 
                                        Width="24" Height="24" Margin="0,0,10,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chọn loại cơ quan" FontWeight="SemiBold" FontSize="14" 
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="34,0,0,0">
                                Chọn đúng loại cơ quan của bạn (UBND xã/phường, Hội Phụ nữ, Đoàn Thanh niên, Trường học, Bệnh viện...). 
                                Hệ thống hỗ trợ <Bold>hơn 70 loại cơ quan</Bold> khác nhau.
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyText}" Margin="34,0,0,0">
                                Hệ thống sẽ tự động tạo cấu trúc thư mục phù hợp với nghiệp vụ cơ quan (11 thư mục chính + thư mục con).
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Bước 2 -->
