<Window x:Class="AIVanBan.Desktop.Views.ApiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="⚙️ Cài đặt" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (click 5 lần để mở chế độ nâng cao) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_Click">
            <TextBlock Text="⚙️ Cài đặt" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Kết nối AI và cấu hình cơ quan" 
                       FontSize="13" Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content: Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ===== TAB 1: Kết nối AI ===== -->
            <TabItem Header="🤖 Kết nối AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="4">
                <!-- Toggle bật/tắt AI -->
                <Border x:Name="brdAiToggle" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <DockPanel>
                        <ToggleButton x:Name="tglAiEnabled" DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      Checked="AiToggle_Changed" Unchecked="AiToggle_Changed"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="✨ Kích hoạt tính năng AI" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtAiToggleHint" 
                                       Text="Bật để sử dụng các tính năng AI nâng cao" 
                                       FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Chế độ kết nối (ẩn, chỉ dev thấy) -->
                <GroupBox x:Name="grpModeSelector" Header="Chế độ kết nối (Nâng cao)" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                          Visibility="Collapsed">
                    <StackPanel Margin="8">
                        <RadioButton x:Name="rbVanBanPlus" Content="☁️ VanBanPlus (khuyến nghị)"
                                     FontWeight="SemiBold" Margin="0,4"
                                     Checked="ApiMode_Changed"/>
                        <TextBlock Text="   Kết nối AI qua hệ thống VanBanPlus" 
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        
                        <RadioButton x:Name="rbGeminiDirect" Content="🔧 Kết nối trực tiếp (Bảo trì)"
                                     Margin="0,4"
                                     Checked="ApiMode_Changed"/>
                        <TextBlock Text="   Chỉ dành cho kỹ thuật viên bảo trì" 
                                   FontSize="11" Foreground="#D32F2F"/>
                        
                        <Button Content="🔒 Tắt chế độ bảo trì" Click="CloseDevMode_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#D32F2F" FontSize="11"
                                HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Thông tin kết nối VanBanPlus -->
                <GroupBox x:Name="grpVanBanPlus" Header="Thông tin kết nối" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="SecondaryLight">
                    <StackPanel Margin="8">
                        <TextBlock Text="Địa chỉ server" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtApiUrl" 
                                 materialDesign:HintAssist.Hint="https://vanbanplus.giakiemso.com"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Mã kích hoạt" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtApiKey"
                                 materialDesign:HintAssist.Hint="vbp_xxxxxxxxxxxx"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12"/>

                        <Button Content="🔍 Kiểm tra kết nối" Click="TestConnection_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtConnectionStatus" FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Dev mode: AI Direct (ẩn mặc định) -->
                <GroupBox x:Name="grpGeminiDirect" Header="🔧 Bảo trì — Kết nối trực tiếp" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="SecondaryLight"
                          Visibility="Collapsed">
                    <StackPanel Margin="8">
                        <TextBlock Text="Mã kết nối AI trực tiếp" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtGeminiKey"
                                 materialDesign:HintAssist.Hint="Chỉ kỹ thuật viên nhập..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="⚠️ Chỉ dùng khi bảo trì. Không dùng cho hoạt động hàng ngày." 
                                   FontSize="11" Foreground="#D32F2F" Margin="0,0,0,8"/>
                        
                        <Button Content="🔍 Test API trực tiếp" Click="TestDirectConnection_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtDirectConnectionStatus" FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Thông tin liên hệ + Lợi ích AI -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📞 Liên hệ hỗ trợ" FontSize="14" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,8"/>
                        <TextBlock FontSize="13" Foreground="#333" Margin="0,0,0,4">
                            <Run FontWeight="SemiBold">Zalo: Thắng Phan — 0907136029</Run>
                        </TextBlock>
                        <TextBlock Text="Hỗ trợ cung cấp mã kích hoạt, hướng dẫn cài đặt, xử lý sự cố" 
                                   FontSize="11" Foreground="#666" Margin="0,0,0,10"/>
                        
                        <Border Background="White" CornerRadius="6" Padding="10">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#333">
                                💡 AI giúp bạn: Soạn văn bản tự động • Kiểm tra chính tả &amp; văn phong • Trích xuất nội dung từ scan/PDF • Đề xuất cải thiện văn bản — Tiết kiệm 70% thời gian xử lý công việc!
                            </TextBlock>
                        </Border>
                        
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#E65100" 
                                       FontWeight="SemiBold" TextAlignment="Center">
                                💰 Chỉ từ 79.000đ/tháng — Đầu tư nhỏ, hiệu quả lớn!
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Trạng thái hiện tại -->
                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" 
                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📊 Trạng thái hiện tại" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtCurrentStatus" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== TAB 2: Cơ quan ===== -->
            <TabItem Header="🏛️ Cơ quan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="4">
                        <Border Background="#FFF8E1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                BorderBrush="#FFB300" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Thông tin cơ quan dùng để tự sinh ký hiệu văn bản" 
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.85">
                                    Theo Phụ lục III, NĐ 30/2020/NĐ-CP — Ký hiệu VB có dạng:
                                    <Run FontWeight="Bold">Số/LoạiVB-ViếtTắtCơQuan</Run>
                                    (VD: <Run FontWeight="Bold">15/CV-UBND</Run>, <Run FontWeight="Bold">8/QĐ-UBND</Run>)
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="Thông tin cơ quan" Margin="0,0,0,12"
                                  materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                            <StackPanel Margin="8">
                                <TextBlock Text="Tên đầy đủ cơ quan *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtOrgName"
                                         materialDesign:HintAssist.Hint="VD: UBND xã Gia Kiệm, Sở Nội vụ tỉnh Đồng Nai..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,12"/>

                                <TextBlock Text="Viết tắt cơ quan * (dùng trong ký hiệu VB)" 
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtOrgAbbreviation"
                                         materialDesign:HintAssist.Hint="VD: UBND, HĐND, ĐU, MTTQ..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         CharacterCasing="Upper"
                                         Margin="0,0,0,4"/>
                                <TextBlock Text="⚠️ Theo Phụ lục VI NĐ 30/2020 — viết IN HOA, không dấu" 
                                           FontSize="11" Opacity="0.6" Margin="0,0,0,12"/>

                                <TextBlock Text="Loại cơ quan" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboOrgType"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Chọn loại cơ quan..."
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Địa danh mặc định (Phụ lục I NĐ 30/2020)" 
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtOrgLocation"
                                         materialDesign:HintAssist.Hint="VD: Gia Kiệm, Hà Nội, TP. Hồ Chí Minh..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,4"/>
                                <TextBlock Text="💡 Dùng cho Phần địa danh-ngày tháng trên VB đi" 
                                           FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Người ký mặc định" Margin="0,0,0,12"
                                  materialDesign:ColorZoneAssist.Mode="SecondaryLight">
                            <StackPanel Margin="8">
                                <TextBlock Text="Họ tên người ký" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDefaultSigner"
                                         materialDesign:HintAssist.Hint="VD: Nguyễn Văn A"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,12"/>

                                <TextBlock Text="Chức danh ký" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDefaultSigningTitle"
                                         materialDesign:HintAssist.Hint="VD: CHỦ TỊCH, GIÁM ĐỐC, TRƯỞ NG PHÒNG"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         CharacterCasing="Upper"
                                         Margin="0,0,0,4"/>
                                <TextBlock Text="💡 Được tự điền vào khi tạo VB mới" 
                                           FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </GroupBox>

                        <Border Background="#E8F5E9" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🔢 Xem trước ký hiệu VB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtOrgPreview" FontSize="13" Foreground="#2E7D32"
                                           Text="VD: 15/CV-UBND, 8/QĐ-UBND, 3/BC-UBND"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="💾 Lưu cài đặt" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,8,0" MinWidth="120"/>
            <Button Content="Hủy" Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
