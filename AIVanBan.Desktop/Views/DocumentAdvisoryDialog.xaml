<Window x:Class="AIVanBan.Desktop.Views.DocumentAdvisoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="📌 AI Tham mưu Xử lý Văn bản" 
        Width="900" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#00796B" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📌 AI THAM MƯU XỬ LÝ VĂN BẢN" 
                              FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtHeaderInfo" 
                              Text="Tóm tắt • Đề xuất xử lý • Deadline • Dự thảo phản hồi" 
                              FontSize="12" Foreground="#B2DFDB" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- Priority badge -->
                <Border x:Name="badgePriority" Grid.Column="1" 
                       CornerRadius="30" Width="80" Height="60" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="txtPriorityIcon" Text="🟡" 
                                  FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtPriorityLabel" Text="Vừa" 
                                  FontSize="11" FontWeight="Bold" Foreground="White"
                                  HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ QUICK INPUT PANEL ═══ -->
        <Border x:Name="pnlQuickInput" Grid.Row="1" Background="White" 
               Padding="16,12" Visibility="Collapsed"
               BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📝 Xem lại hoặc dán nội dung văn bản cần tham mưu:" 
                              FontSize="13" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    <Button x:Name="btnUploadFile" 
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Height="28" Padding="10,0" Margin="12,0,0,0" FontSize="11"
                           Click="UploadFile_Click"
                           ToolTip="Tải file .docx, .pdf, .txt — nội dung sẽ được đổ vào ô bên dưới">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUpload" Width="14" Height="14" 
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="📎 Tải file lên" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="pnlFileInfo" Grid.Row="1" Background="#E0F2F1" CornerRadius="4" 
                       Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" Foreground="#00796B" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtFileInfo" Text="" FontSize="12" Foreground="#00796B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <TextBox x:Name="txtQuickInput" Grid.Row="2"
                        TextWrapping="Wrap" AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Height="160" FontSize="13"
                        materialDesign:HintAssist.Hint="Paste nội dung văn bản vào đây..."
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="txtCharCount" Grid.Column="0" 
                              Text="0 ký tự" FontSize="11" Foreground="#999"
                              VerticalAlignment="Center"/>
                    
                    <ComboBox x:Name="cboQuickDocType" Grid.Column="1" 
                             Width="160" Height="36" Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Loại văn bản (tùy chọn)"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="12"/>
                    
                    <Button x:Name="btnQuickAction" Grid.Column="2"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="#00796B" Foreground="White"
                           Height="36" Padding="20,0"
                           Click="QuickAction_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightbulbOn" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Tham mưu" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="2">
            
            <!-- Loading state -->
            <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6" 
                           Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                <TextBlock x:Name="txtLoadingStatus" 
                          Text="🤖 Đang phân tích văn bản..." 
                          FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0"
                          Foreground="#666"/>
                <TextBlock x:Name="txtLoadingTimer" Text="" 
                          FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                          Foreground="#999"/>
            </StackPanel>

            <!-- Result content -->
            <ScrollViewer x:Name="pnlResults" VerticalScrollBarVisibility="Auto" 
                         Padding="16" Visibility="Collapsed">
                <StackPanel>

                    <!-- Row 1: Badges -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border x:Name="badgeUrgency" Background="#FFCDD2" 
                               CornerRadius="12" Padding="12,4" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock x:Name="txtUrgencyBadge" FontSize="12" FontWeight="Bold" Foreground="#C62828"/>
                        </Border>
                        <Border x:Name="badgePriorityInline" Background="#FFF3E0" 
                               CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                            <TextBlock x:Name="txtPriorityBadge" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="badgeIncomingType" Background="#E3F2FD" 
                               CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                            <TextBlock x:Name="txtIncomingType" FontSize="12" Foreground="#1565C0"/>
                        </Border>
                        <Border x:Name="badgeField" Background="#F3E5F5" 
                               CornerRadius="12" Padding="12,4">
                            <TextBlock x:Name="txtField" FontSize="12" Foreground="#7B1FA2"/>
                        </Border>
                    </StackPanel>

                    <!-- Card 1: Tóm tắt -->
                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="📋 TÓM TẮT NỘI DUNG" 
                                      FontWeight="Bold" FontSize="13" Foreground="#00796B" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtSummary" TextWrapping="Wrap" 
                                      FontSize="13.5" LineHeight="22" Foreground="#333"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 2: Đề xuất xử lý + Phối hợp + Thẩm quyền ký -->
                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="👤 ĐỀ XUẤT XỬ LÝ" 
                                              FontWeight="Bold" FontSize="13" Foreground="#00796B" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtHandler" TextWrapping="Wrap" 
                                              FontSize="14" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="📂 LĨNH VỰC" 
                                              FontWeight="Bold" FontSize="13" Foreground="#00796B" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtFieldDetail" TextWrapping="Wrap" 
                                              FontSize="14" FontWeight="SemiBold" Foreground="#4A148C"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Phối hợp -->
                            <StackPanel x:Name="pnlCoordination" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock Text="🤝 Phối hợp:" FontWeight="SemiBold" FontSize="12" 
                                          Foreground="#555" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtCoordination" TextWrapping="Wrap" 
                                          FontSize="12.5" Foreground="#1565C0"/>
                            </StackPanel>
                            
                            <!-- Thẩm quyền ký -->
                            <Border x:Name="pnlSigning" Background="#E0F2F1" CornerRadius="6" 
                                   Padding="10,6" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✍️ Thẩm quyền ký:" FontWeight="SemiBold" 
                                              FontSize="12" Foreground="#00695C" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtSigningAuthority" TextWrapping="Wrap" 
                                              FontSize="12" FontWeight="Bold" Foreground="#004D40"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 3: Việc cần làm -->
                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="✅ VIỆC CẦN THỰC HIỆN" 
                                      FontWeight="Bold" FontSize="13" Foreground="#00796B" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="lstActionItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F5E9" CornerRadius="6" 
                                               Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="▸" FontSize="14" 
                                                          Foreground="#2E7D32" Margin="0,0,8,0" 
                                                          VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" 
                                                          TextWrapping="Wrap" FontSize="13" Foreground="#333"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 4: Deadline -->
                    <materialDesign:Card x:Name="cardDeadlines" Margin="0,0,0,12" Padding="16"
                                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⏰ CÁC MỐC THỜI HẠN" 
                                      FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="lstDeadlines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF3E0" CornerRadius="6" 
                                               Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📅" FontSize="14" 
                                                          Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Task}" TextWrapping="Wrap" 
                                                              FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                                    <TextBlock Text="{Binding Date}" FontSize="12" 
                                                              Foreground="#E65100" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 5: Căn cứ pháp lý -->
                    <materialDesign:Card x:Name="cardLegalRefs" Margin="0,0,0,12" Padding="16"
                                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚖️ CĂN CỨ PHÁP LÝ VIỆN DẪN" 
                                      FontWeight="Bold" FontSize="13" Foreground="#6A1B9A" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="lstLegalRefs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F3E5F5" CornerRadius="6" 
                                               Padding="10,6" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" 
                                                      FontSize="12.5" Foreground="#4A148C"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 6: Phản hồi -->
                    <materialDesign:Card x:Name="cardResponse" Margin="0,0,0,12" Padding="16"
                                        Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📝 CẦN PHẢN HỒI" 
                                          FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                <Border x:Name="badgeResponseType" Background="#E3F2FD" 
                                       CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                                       VerticalAlignment="Center">
                                    <TextBlock x:Name="txtResponseType" FontSize="11" 
                                              FontWeight="Bold" Foreground="#1565C0"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Dàn ý phản hồi đề xuất:" FontSize="12" 
                                      Foreground="#666" Margin="0,0,0,6"/>
                            <Border Background="#E3F2FD" CornerRadius="6" Padding="14,10">
                                <TextBlock x:Name="txtDraftOutline" TextWrapping="Wrap" 
                                          FontSize="13" LineHeight="22" Foreground="#1A237E"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card 7: Cảnh báo rủi ro -->
                    <materialDesign:Card x:Name="cardRisk" Margin="0,0,0,12" Padding="16"
                                        Visibility="Collapsed">
                        <Border Background="#FFF8E1" CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="⚠️ CẢNH BÁO RỦI RO" 
                                          FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtRiskWarning" TextWrapping="Wrap" 
                                          FontSize="13" LineHeight="20" Foreground="#BF360C"/>
                            </StackPanel>
                        </Border>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- Error state -->
            <StackPanel x:Name="pnlError" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="Collapsed">
                <TextBlock Text="❌" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtError" Text="" TextWrapping="Wrap" MaxWidth="500"
                          FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"
                          Foreground="#D32F2F" TextAlignment="Center"/>
                <Button Content="🔄 Thử lại" Margin="0,16,0,0" 
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Background="#00796B" Foreground="White"
                       Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" 
               BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtFooterInfo" Grid.Column="0" 
                          VerticalAlignment="Center" FontSize="12" Foreground="#888"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnCopy" Content="📋 Copy tóm tắt"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Click="CopySummary_Click"
                           Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button Content="Đóng"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
